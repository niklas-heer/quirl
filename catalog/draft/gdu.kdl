catalog "gdu-draft" {
    provenance author="Carapace contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "gdu" summary="Pretty fast disk usage analyzer written in Go" description="Pretty fast disk usage analyzer written in Go" {
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "--archive-browsing" summary="Enable browsing of zip/jar/tar archives" description="Enable browsing of zip/jar/tar archives"
        flag "--collapse-path" summary="Collapse single-child directory chains" description="Collapse single-child directory chains"
        flag "--config-file" summary="Read config from file (default is $HOME/.gdu.yaml)" description="Read config from file (default is $HOME/.gdu.yaml)" value="value" action="files"
        flag "--const-gc" summary="Enable memory garbage collection during analysis with constant level set by GOGC" description="Enable memory garbage collection during analysis with constant level set by GOGC" short="-g"
        flag "--db" summary="Store analysis in database (*.sqlite for SQLite, *.badger for BadgerDB)" description="Store analysis in database (*.sqlite for SQLite, *.badger for BadgerDB)" short="-D" value="value" action="files"
        flag "--depth" summary="Show directory structure up to specified depth in non-interactive mode" description="Show directory structure up to specified depth in non-interactive mode" value="value"
        flag "--enable-profiling" summary="Enable collection of profiling data and provide it on http://localhost:6060/debug/pprof/" description="Enable collection of profiling data and provide it on http://localhost:6060/debug/pprof/"
        flag "--help" summary="help for gdu" description="help for gdu" short="-h"
        flag "--ignore-dirs" summary="Absolute paths to ignore (separated by comma)" description="Absolute paths to ignore (separated by comma)" short="-i" value="value" repeatable=#true
        flag "--ignore-dirs-pattern" summary="Absolute path patterns to ignore (separated by comma)" description="Absolute path patterns to ignore (separated by comma)" short="-I" value="value" repeatable=#true
        flag "--ignore-from" summary="Read absolute path patterns to ignore from file" description="Read absolute path patterns to ignore from file" short="-X" value="value" action="files"
        flag "--input-file" summary="Import analysis from JSON file" description="Import analysis from JSON file" short="-f" value="value" action="files"
        flag "--interactive" summary="Force interactive mode even when output is not a TTY" description="Force interactive mode even when output is not a TTY"
        flag "--log-file" summary="Path to a logfile" description="Path to a logfile" short="-l" value="value" action="files"
        flag "--max-age" summary="Include files with mtime no older than DURATION (e.g., 7d, 2h30m, 1y2mo)" description="Include files with mtime no older than DURATION (e.g., 7d, 2h30m, 1y2mo)" value="value"
        flag "--max-cores" summary="Set max cores that GDU will use. 4 cores available" description="Set max cores that GDU will use. 4 cores available" short="-m" value="value"
        flag "--min-age" summary="Include files with mtime at least DURATION old (e.g., 30d, 1w)" description="Include files with mtime at least DURATION old (e.g., 30d, 1w)" value="value"
        flag "--mouse" summary="Use mouse" description="Use mouse"
        flag "--no-color" summary="Do not use colorized output" description="Do not use colorized output" short="-c"
        flag "--no-cross" summary="Do not cross filesystem boundaries" description="Do not cross filesystem boundaries" short="-x"
        flag "--no-delete" summary="Do not allow deletions" description="Do not allow deletions"
        flag "--no-hidden" summary="Ignore hidden directories (beginning with dot)" description="Ignore hidden directories (beginning with dot)" short="-H"
        flag "--no-prefix" summary="Show sizes as raw numbers without any prefixes in non-interactive mode" description="Show sizes as raw numbers without any prefixes in non-interactive mode"
        flag "--no-progress" summary="Do not show progress in non-interactive mode" description="Do not show progress in non-interactive mode" short="-p"
        flag "--no-spawn-shell" summary="Do not allow spawning shell" description="Do not allow spawning shell"
        flag "--no-unicode" summary="Do not use Unicode symbols (for size bar)" description="Do not use Unicode symbols (for size bar)" short="-u"
        flag "--no-view-file" summary="Do not allow viewing file contents" description="Do not allow viewing file contents"
        flag "--non-interactive" summary="Do not run in interactive mode" description="Do not run in interactive mode" short="-n"
        flag "--output-file" summary="Export all info into file as JSON" description="Export all info into file as JSON" short="-o" value="value" action="files"
        flag "--reverse-sort" summary="Reverse sorting order (smallest to largest) in non-interactive mode" description="Reverse sorting order (smallest to largest) in non-interactive mode"
        flag "--sequential" summary="Use sequential scanning (intended for rotating HDDs)" description="Use sequential scanning (intended for rotating HDDs)"
        flag "--show-annexed-size" summary="Use apparent size of git-annex'ed files" description="Use apparent size of git-annex'ed files" short="-A"
        flag "--show-apparent-size" summary="Show apparent size" description="Show apparent size" short="-a"
        flag "--show-disks" summary="Show all mounted disks" description="Show all mounted disks" short="-d"
        flag "--show-relative-size" summary="Show relative size" description="Show relative size" short="-B"
        flag "--si" summary="Show sizes with decimal SI prefixes (kB, MB, GB) instead of binary prefixes (KiB, MiB, GiB)" description="Show sizes with decimal SI prefixes (kB, MB, GB) instead of binary prefixes (KiB, MiB, GiB)"
        flag "--since" summary="Include files with mtime >= WHEN (RFC3339 timestamp or YYYY-MM-DD)" description="Include files with mtime >= WHEN (RFC3339 timestamp or YYYY-MM-DD)" value="value"
        flag "--summarize" summary="Show only a total in non-interactive mode" description="Show only a total in non-interactive mode" short="-s"
        flag "--until" summary="Include files with mtime <= WHEN (RFC3339 timestamp or YYYY-MM-DD)" description="Include files with mtime <= WHEN (RFC3339 timestamp or YYYY-MM-DD)" value="value"
        flag "--version" summary="Print version" description="Print version" short="-v"
        flag "--write-config" summary="Write current configuration to file (default is $HOME/.gdu.yaml)" description="Write current configuration to file (default is $HOME/.gdu.yaml)"
    }
}

catalog "java-draft" {
    provenance author="Carapace contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "java" summary="Launches a Java application" description="Launches a Java application" {
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "--add-modules" summary="root modules to resolve in addition to the initial module" description="root modules to resolve in addition to the initial module" value="value"
        flag "--agentlib" summary="load native agent library" description="load native agent library" value="value"
        flag "--agentpath" summary="load native agent library by full pathname" description="load native agent library by full pathname" value="value"
        flag "--class-path" summary="class search path of directories and zip/jar files" description="class search path of directories and zip/jar files" value="value"
        flag "--classpath" summary="class search path of directories and zip/jar files" description="class search path of directories and zip/jar files" value="value"
        flag "--cp" summary="class search path of directories and zip/jar files" description="class search path of directories and zip/jar files" value="value"
        flag "--d32" summary="use a 32-bit data model if available" description="use a 32-bit data model if available"
        flag "--d64" summary="use a 64-bit data model if available" description="use a 64-bit data model if available"
        flag "--da" summary="disable assertions with specified granularity" description="disable assertions with specified granularity" value="value"
        flag "--describe-module" summary="describe a module and exit" description="describe a module and exit" value="value"
        flag "--disableassertions" summary="disable assertions with specified granularity" description="disable assertions with specified granularity" value="value"
        flag "--disablesystemassertions" summary="disable system assertions" description="disable system assertions"
        flag "--dry-run" summary="create VM and load main class but do not execute main method" description="create VM and load main class but do not execute main method"
        flag "--dsa" summary="disable system assertions" description="disable system assertions"
        flag "--ea" summary="enable assertions with specified granularity" description="enable assertions with specified granularity" value="value"
        flag "--enable-native-access" summary="modules that are permitted to perform restricted native operations" description="modules that are permitted to perform restricted native operations" value="value"
        flag "--enable-preview" summary="allow classes to depend on preview features of this release" description="allow classes to depend on preview features of this release"
        flag "--enableassertions" summary="enable assertions with specified granularity" description="enable assertions with specified granularity" value="value"
        flag "--enablesystemassertions" summary="enable system assertions" description="enable system assertions"
        flag "--esa" summary="enable system assertions" description="enable system assertions"
        flag "--help" summary="print this help message to the output stream" description="print this help message to the output stream"
        flag "--help-extra" summary="print help on extra options to the output stream" description="print help on extra options to the output stream"
        flag "--jar" summary="jar file to execute" description="jar file to execute" value="value" action="files"
        flag "--javaagent" summary="load Java programming language agent, see java.lang.instrument" description="load Java programming language agent, see java.lang.instrument" value="value"
        flag "--list-modules" summary="list observable modules and exit" description="list observable modules and exit"
        flag "--module" summary="execute the main class in a module" description="execute the main class in a module" value="value"
        flag "--module-path" summary="module path" description="module path" value="value"
        flag "--server" summary="to select the \"server\" VM" description="to select the \"server\" VM"
        flag "--show-module-resolution" summary="show module resolution output during startup" description="show module resolution output during startup"
        flag "--show-version" summary="print product version to the output stream and continue" description="print product version to the output stream and continue"
        flag "--showversion" summary="print product version and continue" description="print product version and continue"
        flag "--splash" summary="show splash screen with specified image" description="show splash screen with specified image" value="value" action="files"
        flag "--upgrade-module-path" summary="module path to replace upgradeable modules" description="module path to replace upgradeable modules" value="value"
        flag "--validate-modules" summary="validate all modules and exit" description="validate all modules and exit"
        flag "--verbose" summary="enable verbose output" description="enable verbose output" value="value"
        flag "--version" summary="print product version to the output stream and exit" description="print product version to the output stream and exit"
        flag "-D" summary="set a system property" description="set a system property" value="value" repeatable=#true
        flag "-X" summary="print help on non-standard options" description="print help on non-standard options"
    }
}

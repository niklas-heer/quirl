catalog "watchexec-draft" {
    provenance author="Carapace contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "watchexec" summary="Execute commands when watched files change" description="Execute commands when watched files change" {
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "--changes-only" summary="Only print path change information. Overridden by --verbose" description="Only print path change information. Overridden by --verbose"
        flag "--clear" summary="Clear screen before executing command" description="Clear screen before executing command" short="-c"
        flag "--debounce" summary="Set the timeout between detected change and command execution, defaults to 100ms" description="Set the timeout between detected change and command execution, defaults to 100ms" short="-d" value="value"
        flag "--exts" summary="Comma-separated list of file extensions to watch" description="Comma-separated list of file extensions to watch" short="-e" value="value" action="files"
        flag "--filter" summary="Ignore all modifications except those matching the pattern" description="Ignore all modifications except those matching the pattern" short="-f" value="value"
        flag "--force-poll" summary="Force polling mode (interval in milliseconds)" description="Force polling mode (interval in milliseconds)" value="value"
        flag "--help" summary="Prints help information" description="Prints help information" short="-h"
        flag "--ignore" summary="Ignore modifications to paths matching the pattern" description="Ignore modifications to paths matching the pattern" short="-i" value="value"
        flag "--no-default-ignore" summary="Skip auto-ignoring of commonly ignored globs" description="Skip auto-ignoring of commonly ignored globs"
        flag "--no-environment" summary="Do not set WATCHEXEC_*_PATH environment variables for the command" description="Do not set WATCHEXEC_*_PATH environment variables for the command"
        flag "--no-ignore" summary="Skip auto-loading of ignore files (.gitignore, .ignore, etc.) for filtering" description="Skip auto-loading of ignore files (.gitignore, .ignore, etc.) for filtering"
        flag "--no-meta" summary="Ignore metadata changes" description="Ignore metadata changes"
        flag "--no-process-group" summary="Do not use a process group when running the command" description="Do not use a process group when running the command"
        flag "--no-shell" summary="Do not wrap command in a shell. Deprecated: use --shell=none instead." description="Do not wrap command in a shell. Deprecated: use --shell=none instead." short="-n"
        flag "--no-vcs-ignore" summary="Skip auto-loading of .gitignore files for filtering" description="Skip auto-loading of .gitignore files for filtering"
        flag "--notify" summary="Send a desktop notification when watchexec notices a change" description="Send a desktop notification when watchexec notices a change" short="-N"
        flag "--on-busy-update" summary="Select the behaviour to use when receiving events while the command is running." description="Select the behaviour to use when receiving events while the command is running." value="value"
        flag "--postpone" summary="Wait until first change to execute command" description="Wait until first change to execute command" short="-p"
        flag "--restart" summary="Restart the process if it's still running." description="Restart the process if it's still running." short="-r"
        flag "--shell" summary="Use a different shell, or `none`. E.g. --shell=bash" description="Use a different shell, or `none`. E.g. --shell=bash" value="value"
        flag "--signal" summary="Send signal to process upon changes, e.g. SIGHUP" description="Send signal to process upon changes, e.g. SIGHUP" short="-s" value="value"
        flag "--verbose" summary="Print debugging messages to stderr" description="Print debugging messages to stderr" short="-v"
        flag "--version" summary="Prints version information" description="Prints version information" short="-V"
        flag "--watch" summary="Watch a specific file or directory" description="Watch a specific file or directory" short="-w" value="value" action="files"
        flag "--watch-when-idle" summary="Deprecated alias for --on-busy-update=do-nothing, which will become the" description="Deprecated alias for --on-busy-update=do-nothing, which will become the" short="-W"
    }
}

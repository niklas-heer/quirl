catalog "ping-draft" {
    provenance author="Carapace contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "ping" summary="send ICMP ECHO_REQUEST to network hosts" description="send ICMP ECHO_REQUEST to network hosts" {
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "-4" summary="use IPv4" description="use IPv4"
        flag "-6" summary="use IPv6" description="use IPv6"
        flag "-A" summary="use adaptive ping" description="use adaptive ping"
        flag "-B" summary="sticky source address" description="sticky source address"
        flag "-D" summary="print timestamps" description="print timestamps"
        flag "-F" summary="define flow label, default is random" description="define flow label, default is random" value="value"
        flag "-I" summary="either interface name or address" description="either interface name or address" value="value"
        flag "-L" summary="suppress loopback of multicast packets" description="suppress loopback of multicast packets"
        flag "-M" summary="define mtu discovery" description="define mtu discovery" value="value"
        flag "-O" summary="report outstanding replies" description="report outstanding replies"
        flag "-Q" summary="use quality of service <tclass> bits" description="use quality of service <tclass> bits" value="value"
        flag "-R" summary="record route" description="record route"
        flag "-S" summary="use <size> as SO_SNDBUF socket option value" description="use <size> as SO_SNDBUF socket option value" value="value"
        flag "-T" summary="define timestamp, can be one of <tsonly|tsandaddr|tsprespec>" description="define timestamp, can be one of <tsonly|tsandaddr|tsprespec>" value="value"
        flag "-U" summary="print user-to-user latency" description="print user-to-user latency"
        flag "-V" summary="print version and exit" description="print version and exit"
        flag "-W" summary="time to wait for response" description="time to wait for response" value="value"
        flag "-a" summary="use audible ping" description="use audible ping"
        flag "-b" summary="allow pinging broadcast" description="allow pinging broadcast"
        flag "-c" summary="stop after <count> replies" description="stop after <count> replies" value="value"
        flag "-d" summary="use SO_DEBUG socket option" description="use SO_DEBUG socket option"
        flag "-f" summary="flood ping" description="flood ping"
        flag "-h" summary="print help and exit" description="print help and exit"
        flag "-i" summary="seconds between sending each packet" description="seconds between sending each packet" value="value"
        flag "-l" summary="send <preload> number of packages while waiting replies" description="send <preload> number of packages while waiting replies" value="value"
        flag "-m" summary="tag the packets going out" description="tag the packets going out" value="value"
        flag "-n" summary="no dns name resolution" description="no dns name resolution"
        flag "-p" summary="contents of padding byte" description="contents of padding byte" value="value"
        flag "-q" summary="quiet output" description="quiet output"
        flag "-s" summary="use <size> as number of data bytes to be sent" description="use <size> as number of data bytes to be sent" value="value"
        flag "-t" summary="define time to live" description="define time to live" value="value"
        flag "-v" summary="verbose output" description="verbose output"
        flag "-w" summary="reply wait <deadline> in seconds" description="reply wait <deadline> in seconds" value="value"
    }
}

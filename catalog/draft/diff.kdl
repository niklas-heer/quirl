catalog "diff-draft" {
    provenance author="Carapace contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "diff" summary="compare files line by line" description="compare files line by line" {
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "--brief" summary="report only when files differ" description="report only when files differ" short="-q"
        flag "--changed-group-format" summary="set changed group format" description="set changed group format" value="value"
        flag "--color" summary="colorize the output" description="colorize the output" value="value"
        flag "--context" summary="output NUM (default 3) lines of copied context" description="output NUM (default 3) lines of copied context" short="-c" value="value"
        flag "--ed" summary="output an ed script" description="output an ed script" short="-e"
        flag "--exclude" summary="exclude files that match PAT" description="exclude files that match PAT" short="-x" value="value"
        flag "--exclude-from" summary="exclude files that match any pattern in FILE" description="exclude files that match any pattern in FILE" short="-X" value="value" action="files"
        flag "--expand-tabs" summary="expand tabs to spaces in output" description="expand tabs to spaces in output" short="-t"
        flag "--forward-ed" summary="output a reversed ed script" description="output a reversed ed script" short="-f"
        flag "--from-file" summary="compare FILE1 to all operands" description="compare FILE1 to all operands" value="value" action="files"
        flag "--help" summary="display this help and exit" description="display this help and exit"
        flag "--horizon-lines" summary="keep NUM lines of the common prefix and suffix" description="keep NUM lines of the common prefix and suffix" value="value"
        flag "--ifdef" summary="output merged file with '#ifdef NAME' diffs" description="output merged file with '#ifdef NAME' diffs" short="-D" value="value"
        flag "--ignore-all-space" summary="ignore all white space" description="ignore all white space" short="-w"
        flag "--ignore-blank-lines" summary="ignore changes where lines are all blank" description="ignore changes where lines are all blank" short="-B"
        flag "--ignore-case" summary="ignore case differences in file contents" description="ignore case differences in file contents" short="-i"
        flag "--ignore-file-name-case" summary="ignore case when comparing file names" description="ignore case when comparing file names"
        flag "--ignore-matching-lines" summary="ignore changes where all lines match RE" description="ignore changes where all lines match RE" short="-I" value="value"
        flag "--ignore-space-change" summary="ignore changes in the amount of white space" description="ignore changes in the amount of white space" short="-b"
        flag "--ignore-tab-expansion" summary="ignore changes due to tab expansion" description="ignore changes due to tab expansion" short="-E"
        flag "--ignore-trailing-space" summary="ignore white space at line end" description="ignore white space at line end" short="-Z"
        flag "--initial-tab" summary="make tabs line up by prepending a tab" description="make tabs line up by prepending a tab" short="-T"
        flag "--label" summary="use LABEL instead of file name and timestamp" description="use LABEL instead of file name and timestamp" short="-L" value="value"
        flag "--left-column" summary="output only the left column of common lines" description="output only the left column of common lines"
        flag "--line-format" summary="format all input lines with LFMT" description="format all input lines with LFMT" value="value"
        flag "--minimal" summary="try hard to find a smaller set of changes" description="try hard to find a smaller set of changes" short="-d"
        flag "--new-file" summary="treat absent files as empty" description="treat absent files as empty" short="-N"
        flag "--new-group-format" summary="set new group format" description="set new group format" value="value"
        flag "--new-line-format" summary="set new line format" description="set new line format" value="value"
        flag "--no-dereference" summary="don't follow symbolic links" description="don't follow symbolic links"
        flag "--no-ignore-file-name-case" summary="consider case when comparing file names" description="consider case when comparing file names"
        flag "--normal" summary="output a normal diff (the default)" description="output a normal diff (the default)"
        flag "--old-group-format" summary="set old group format" description="set old group format" value="value"
        flag "--old-line-format" summary="set old line format" description="set old line format" value="value"
        flag "--paginate" summary="pass output through 'pr' to paginate it" description="pass output through 'pr' to paginate it" short="-l"
        flag "--palette" summary="the colors to use when --color is active" description="the colors to use when --color is active" value="value"
        flag "--rcs" summary="output an RCS format diff" description="output an RCS format diff" short="-n"
        flag "--recursive" summary="recursively compare any subdirectories found" description="recursively compare any subdirectories found" short="-r"
        flag "--report-identical-files" summary="report when two files are the same" description="report when two files are the same" short="-s"
        flag "--show-c-function" summary="show which C function each change is in" description="show which C function each change is in" short="-p"
        flag "--show-function-line" summary="show the most recent line matching RE" description="show the most recent line matching RE" short="-F" value="value"
        flag "--side-by-side" summary="output in two columns" description="output in two columns" short="-y"
        flag "--speed-large-files" summary="assume large files and many scattered small changes" description="assume large files and many scattered small changes" short="-H"
        flag "--starting-file" summary="start with FILE when comparing directories" description="start with FILE when comparing directories" short="-S" value="value"
        flag "--strip-trailing-cr" summary="strip trailing carriage return on input" description="strip trailing carriage return on input"
        flag "--suppress-blank-empty" summary="suppress space or tab before empty output lines" description="suppress space or tab before empty output lines"
        flag "--suppress-common-lines" summary="do not output common lines" description="do not output common lines"
        flag "--tabsize" summary="tab stops every NUM (default 8) print columns" description="tab stops every NUM (default 8) print columns" value="value"
        flag "--text" summary="treat all files as text" description="treat all files as text" short="-a"
        flag "--to-file" summary="compare all operands to FILE2" description="compare all operands to FILE2" value="value" action="files"
        flag "--unchanged-group-format" summary="set unchanged group format" description="set unchanged group format" value="value"
        flag "--unchanged-line-format" summary="set unchanged line format" description="set unchanged line format" value="value"
        flag "--unidirectional-new-file" summary="treat absent first files as empty" description="treat absent first files as empty" short="-P"
        flag "--unified" summary="output NUM (default 3) lines of unified context" description="output NUM (default 3) lines of unified context" short="-u" value="value"
        flag "--version" summary="output version information and exit" description="output version information and exit" short="-v"
        flag "--width" summary="output at most NUM (default 130) print columns" description="output at most NUM (default 130) print columns" short="-W" value="value"
        flag "-C" summary="output NUM (default 3) lines of copied context" description="output NUM (default 3) lines of copied context" value="value"
        flag "-U" summary="output NUM (default 3) lines of unified context" description="output NUM (default 3) lines of unified context" value="value"
    }
}

catalog "hyperfine-draft" {
    provenance author="Carapace contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "hyperfine" summary="A command-line benchmarking tool." description="A command-line benchmarking tool." {
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "--cleanup" summary="Execute CMD after the completion of all benchmarking runs for each individual command to be benchmarked. This is useful if the commands to be benchmarked produce artifacts that need to be cleaned up." description="Execute CMD after the completion of all benchmarking runs for each individual command to be benchmarked. This is useful if the commands to be benchmarked produce artifacts that need to be cleaned up." short="-c" value="value"
        flag "--command-name" summary="Give a meaningful name to a command. This can be specified multiple times if several commands are benchmarked." description="Give a meaningful name to a command. This can be specified multiple times if several commands are benchmarked." short="-n" value="value" repeatable=#true
        flag "--conclude" summary="Execute CMD after each timing run. This is useful for killing long-running processes started (e.g. a web server started in --prepare), for example." description="Execute CMD after each timing run. This is useful for killing long-running processes started (e.g. a web server started in --prepare), for example." short="-C" value="value" repeatable=#true
        flag "--export-asciidoc" summary="Export the timing summary statistics as an AsciiDoc table to the given FILE. The output time unit can be changed using the --time-unit option." description="Export the timing summary statistics as an AsciiDoc table to the given FILE. The output time unit can be changed using the --time-unit option." value="value" action="files"
        flag "--export-csv" summary="Export the timing summary statistics as CSV to the given FILE. If you need the timing results for each individual run, use the JSON export format. The output time unit is always seconds." description="Export the timing summary statistics as CSV to the given FILE. If you need the timing results for each individual run, use the JSON export format. The output time unit is always seconds." value="value" action="files"
        flag "--export-json" summary="Export the timing summary statistics and timings of individual runs as JSON to the given FILE. The output time unit is always seconds" description="Export the timing summary statistics and timings of individual runs as JSON to the given FILE. The output time unit is always seconds" value="value" action="files"
        flag "--export-markdown" summary="Export the timing summary statistics as a Markdown table to the given FILE. The output time unit can be changed using the --time-unit option." description="Export the timing summary statistics as a Markdown table to the given FILE. The output time unit can be changed using the --time-unit option." value="value" action="files"
        flag "--export-orgmode" summary="Export the timing summary statistics as an Emacs org-mode table to the given FILE. The output time unit can be changed using the --time-unit option." description="Export the timing summary statistics as an Emacs org-mode table to the given FILE. The output time unit can be changed using the --time-unit option." value="value" action="files"
        flag "--help" summary="Print help" description="Print help" short="-h"
        flag "--ignore-failure" summary="Ignore failures of the benchmarked programs. Without a value or with 'all-non-zero', all non-zero exit codes are ignored. You can also provide a comma-separated list of exit codes to ignore (e.g., --ignore-failure=1,2)." description="Ignore failures of the benchmarked programs. Without a value or with 'all-non-zero', all non-zero exit codes are ignored. You can also provide a comma-separated list of exit codes to ignore (e.g., --ignore-failure=1,2)." short="-i" value="value"
        flag "--input" summary="Control where the input of the benchmark comes from." description="Control where the input of the benchmark comes from." value="value"
        flag "--max-runs" summary="Perform at most NUM runs for each command. By default, there is no limit." description="Perform at most NUM runs for each command. By default, there is no limit." short="-M" value="value"
        flag "--min-runs" summary="Perform at least NUM runs for each command (default: 10)." description="Perform at least NUM runs for each command (default: 10)." short="-m" value="value"
        flag "--output" summary="Control where the output of the benchmark is redirected. Note that some programs like 'grep' detect when standard output is /dev/null and apply certain optimizations. To avoid that, consider using '--output=pipe'." description="Control where the output of the benchmark is redirected. Note that some programs like 'grep' detect when standard output is /dev/null and apply certain optimizations. To avoid that, consider using '--output=pipe'." value="value" repeatable=#true
        flag "--parameter-list" summary="Perform benchmark runs for each value in the comma-separated list VALUES. Replaces the string '{VAR}' in each command by the current parameter value." description="Perform benchmark runs for each value in the comma-separated list VALUES. Replaces the string '{VAR}' in each command by the current parameter value." short="-L" value="value" repeatable=#true
        flag "--parameter-scan" summary="Perform benchmark runs for each value in the range MIN..MAX. Replaces the string '{VAR}' in each command by the current parameter value." description="Perform benchmark runs for each value in the range MIN..MAX. Replaces the string '{VAR}' in each command by the current parameter value." short="-P" value="value"
        flag "--parameter-step-size" summary="This argument requires --parameter-scan to be specified as well. Traverse the range MIN..MAX in steps of DELTA." description="This argument requires --parameter-scan to be specified as well. Traverse the range MIN..MAX in steps of DELTA." short="-D" value="value"
        flag "--prepare" summary="Execute CMD before each timing run. This is useful for clearing disk caches, for example." description="Execute CMD before each timing run. This is useful for clearing disk caches, for example." short="-p" value="value" repeatable=#true
        flag "--reference" summary="The reference command for the relative comparison of results. If this is unset, results are compared with the fastest command as reference." description="The reference command for the relative comparison of results. If this is unset, results are compared with the fastest command as reference." value="value"
        flag "--reference-name" summary="Give a meaningful name to the reference command." description="Give a meaningful name to the reference command." value="value"
        flag "--runs" summary="Perform exactly NUM runs for each command. If this option is not specified, hyperfine automatically determines the number of runs." description="Perform exactly NUM runs for each command. If this option is not specified, hyperfine automatically determines the number of runs." short="-r" value="value"
        flag "--setup" summary="Execute CMD before each set of timing runs. This is useful for compiling your software with the provided parameters, or to do any other work that should happen once before a series of benchmark runs, not every time as would happen with the --prepare option." description="Execute CMD before each set of timing runs. This is useful for compiling your software with the provided parameters, or to do any other work that should happen once before a series of benchmark runs, not every time as would happen with the --prepare option." short="-s" value="value"
        flag "--shell" summary="Set the shell to use for executing benchmarked commands. This can be the name or the path to the shell executable, or a full command line like \"bash --norc\". It can also be set to \"default\" to explicitly select the default shell on this platform. Finally, this can also be set to \"none\" to disable the shell. In this case, commands will be executed directly. They can still have arguments, but more complex things like \"sleep 0.1; sleep 0.2\" are not possible without a shell." description="Set the shell to use for executing benchmarked commands. This can be the name or the path to the shell executable, or a full command line like \"bash --norc\". It can also be set to \"default\" to explicitly select the default shell on this platform. Finally, this can also be set to \"none\" to disable the shell. In this case, commands will be executed directly. They can still have arguments, but more complex things like \"sleep 0.1; sleep 0.2\" are not possible without a shell." short="-S" value="value"
        flag "--show-output" summary="Print the stdout and stderr of the benchmark instead of suppressing it. This will increase the time it takes for benchmarks to run, so it should only be used for debugging purposes or when trying to benchmark output speed." description="Print the stdout and stderr of the benchmark instead of suppressing it. This will increase the time it takes for benchmarks to run, so it should only be used for debugging purposes or when trying to benchmark output speed."
        flag "--sort" summary="Specify the sort order of the speed comparison summary and the exported tables for markup formats (Markdown, AsciiDoc, org-mode):" description="Specify the sort order of the speed comparison summary and the exported tables for markup formats (Markdown, AsciiDoc, org-mode):" value="value"
        flag "--style" summary="Set output style type (default: auto). Set this to 'basic' to disable output coloring and interactive elements. Set it to 'full' to enable all effects even if no interactive terminal was detected. Set this to 'nocolor' to keep the interactive output without any colors. Set this to 'color' to keep the colors without any interactive output. Set this to 'none' to disable all the output of the tool." description="Set output style type (default: auto). Set this to 'basic' to disable output coloring and interactive elements. Set it to 'full' to enable all effects even if no interactive terminal was detected. Set this to 'nocolor' to keep the interactive output without any colors. Set this to 'color' to keep the colors without any interactive output. Set this to 'none' to disable all the output of the tool." value="value"
        flag "--time-unit" summary="Set the time unit to be used. Possible values: microsecond, millisecond, second. If the option is not given, the time unit is determined automatically. This option affects the standard output as well as all export formats except for CSV and JSON." description="Set the time unit to be used. Possible values: microsecond, millisecond, second. If the option is not given, the time unit is determined automatically. This option affects the standard output as well as all export formats except for CSV and JSON." short="-u" value="value"
        flag "--version" summary="Print version" description="Print version" short="-V"
        flag "--warmup" summary="Perform NUM warmup runs before the actual benchmark. This can be used to fill (disk) caches for I/O-heavy programs." description="Perform NUM warmup runs before the actual benchmark. This can be used to fill (disk) caches for I/O-heavy programs." short="-w" value="value"
        flag "-N" summary="An alias for '--shell=none'." description="An alias for '--shell=none'."
    }
}

catalog "sftp-draft" {
    provenance author="Carapace contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "sftp" summary="OpenSSH secure file transfer" description="OpenSSH secure file transfer" {
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "-4" summary="Forces sftp to use IPv4 addresses only." description="Forces sftp to use IPv4 addresses only."
        flag "-6" summary="Forces sftp to use IPv6 addresses only." description="Forces sftp to use IPv6 addresses only."
        flag "-A" summary="Allows forwarding of ssh-agent(1) to the remote system." description="Allows forwarding of ssh-agent(1) to the remote system."
        flag "-B" summary="Specify the size of the buffer that sftp uses when transferring files." description="Specify the size of the buffer that sftp uses when transferring files." value="value"
        flag "-C" summary="Enables compression (via ssh's -C flag)." description="Enables compression (via ssh's -C flag)."
        flag "-D" summary="Connect directly to a local sftp server (rather than via ssh(1))." description="Connect directly to a local sftp server (rather than via ssh(1))." value="value" action="directories"
        flag "-F" summary="Specifies an alternative per-user configuration file for ssh(1)." description="Specifies an alternative per-user configuration file for ssh(1)." value="value" action="files"
        flag "-J" summary="Connect to the target host by first making an sftp connection to the jump host described by destination." description="Connect to the target host by first making an sftp connection to the jump host described by destination." value="value" action="hostnames"
        flag "-N" summary="Disables quiet mode, e.g. to override the implicit quiet mode set by the -b flag." description="Disables quiet mode, e.g. to override the implicit quiet mode set by the -b flag."
        flag "-P" summary="Specifies the port to connect to on the remote host." description="Specifies the port to connect to on the remote host." value="value"
        flag "-R" summary="Specify how many requests may be outstanding at any one time." description="Specify how many requests may be outstanding at any one time." value="value"
        flag "-S" summary="Name of the program to use for the encrypted connection." description="Name of the program to use for the encrypted connection." value="value"
        flag "-a" summary="Attempt to continue interrupted transfers rather than overwriting existing partial or complete copies of files." description="Attempt to continue interrupted transfers rather than overwriting existing partial or complete copies of files."
        flag "-b" summary="Batch mode reads a series of commands from an input batchfile instead of stdin." description="Batch mode reads a series of commands from an input batchfile instead of stdin." value="value" action="files"
        flag "-c" summary="Selects the cipher to use for encrypting the data transfers." description="Selects the cipher to use for encrypting the data transfers." value="value"
        flag "-f" summary="Requests that files be flushed to disk immediately after transfer." description="Requests that files be flushed to disk immediately after transfer."
        flag "-i" summary="Selects the file from which the identity (private key) for public key authentication is read." description="Selects the file from which the identity (private key) for public key authentication is read." value="value" action="files"
        flag "-l" summary="Limits the used bandwidth, specified in Kbit/s." description="Limits the used bandwidth, specified in Kbit/s." value="value"
        flag "-o" summary="Can be used to pass options to ssh in the format used in ssh_config(5)." description="Can be used to pass options to ssh in the format used in ssh_config(5)." value="value"
        flag "-p" summary="Preserves modification times, access times, and modes from the original files transferred." description="Preserves modification times, access times, and modes from the original files transferred."
        flag "-q" summary="Quiet mode: disables the progress meter as well as warning and diagnostic messages from ssh(1)." description="Quiet mode: disables the progress meter as well as warning and diagnostic messages from ssh(1)."
        flag "-r" summary="Recursively copy entire directories when uploading and downloading." description="Recursively copy entire directories when uploading and downloading."
        flag "-s" summary="Specifies the SSH2 subsystem or the path for an sftp server on the remote host." description="Specifies the SSH2 subsystem or the path for an sftp server on the remote host." value="value"
        flag "-v" summary="Raise logging level.  This option is also passed to ssh." description="Raise logging level.  This option is also passed to ssh."
    }
}

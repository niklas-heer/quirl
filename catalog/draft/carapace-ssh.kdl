catalog "carapace-ssh-draft" {
    provenance author="Carapace contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "ssh" summary="OpenSSH remote login client" description="OpenSSH remote login client" {
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "--4" summary="Forces ssh to use IPv4 addresses only" description="Forces ssh to use IPv4 addresses only" short="-4"
        flag "--6" summary="Forces ssh to use IPv6 addresses only" description="Forces ssh to use IPv6 addresses only" short="-6"
        flag "--a" summary="Disables forwarding of the authentication agent connection." description="Disables forwarding of the authentication agent connection." short="-a"
        flag "--b" summary="Use bind_address on the local machine as the source address of the connection" description="Use bind_address on the local machine as the source address of the connection" short="-b" value="value"
        flag "--c" summary="Selects the cipher specification for encrypting the session" description="Selects the cipher specification for encrypting the session" short="-c" value="value"
        flag "--e" summary="Sets the escape character for sessions with a pty" description="Sets the escape character for sessions with a pty" short="-e" value="value"
        flag "--f" summary="Requests ssh to go to background just before command execution" description="Requests ssh to go to background just before command execution" short="-f"
        flag "--g" summary="Allows remote hosts to connect to local forwarded ports" description="Allows remote hosts to connect to local forwarded ports" short="-g"
        flag "--i" summary="Selects a file from which the identity (private key) is read" description="Selects a file from which the identity (private key) is read" short="-i" value="value"
        flag "--k" summary="Disables forwarding of GSSAPI credentials to the server" description="Disables forwarding of GSSAPI credentials to the server" short="-k"
        flag "--l" summary="Specifies the user to log in as on the remote machine" description="Specifies the user to log in as on the remote machine" short="-l" value="value"
        flag "--m" summary="A comma-separated list of MAC algorithms" description="A comma-separated list of MAC algorithms" short="-m" value="value"
        flag "--n" summary="Redirects stdin from /dev/null" description="Redirects stdin from /dev/null" short="-n"
        flag "--o" summary="Can be used to give options in the format used in the configuration file" description="Can be used to give options in the format used in the configuration file" short="-o" value="value"
        flag "--p" summary="Port to connect to on the remote host" description="Port to connect to on the remote host" short="-p" value="value"
        flag "--q" summary="Quiet mode" description="Quiet mode" short="-q"
        flag "--s" summary="May be used to request invocation of a subsystem on the remote system" description="May be used to request invocation of a subsystem on the remote system" short="-s"
        flag "--t" summary="Force pseudo-terminal allocation" description="Force pseudo-terminal allocation" short="-t"
        flag "--v" summary="Verbose mode" description="Verbose mode" short="-v"
        flag "--w" summary="Requests tunnel device forwarding" description="Requests tunnel device forwarding" short="-w" value="value"
        flag "--x" summary="Disables X11 forwarding" description="Disables X11 forwarding" short="-x"
        flag "--y" summary="Send log information using the syslog system module" description="Send log information using the syslog system module" short="-y"
    }
}

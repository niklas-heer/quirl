catalog "aria2c-draft" {
    provenance author="Carapace contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "aria2c" summary="The ultra fast download utility" description="The ultra fast download utility" {
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "--all-proxy" summary="Use a proxy server for all protocols" description="Use a proxy server for all protocols" value="value"
        flag "--all-proxy-passwd" summary="Set password for --all-proxy" description="Set password for --all-proxy" value="value"
        flag "--all-proxy-user" summary="Set user for --all-proxy" description="Set user for --all-proxy" value="value"
        flag "--allow-overwrite" summary="Restart download from scratch if the corresponding control file doesn't exist" description="Restart download from scratch if the corresponding control file doesn't exist"
        flag "--allow-piece-length-change" summary="If false is given, aria2 aborts download when a piece length is different from one in a control file" description="If false is given, aria2 aborts download when a piece length is different from one in a control file"
        flag "--always-resume" summary="Always resume download" description="Always resume download"
        flag "--async-dns" summary="Enable asynchronous DNS" description="Enable asynchronous DNS"
        flag "--async-dns-server" summary="Comma separated list of DNS server address used in asynchronous DNS resolver" description="Comma separated list of DNS server address used in asynchronous DNS resolver" value="value"
        flag "--auto-file-renaming" summary="Rename file name if the same file already exists" description="Rename file name if the same file already exists"
        flag "--auto-save-interval" summary="Save a control file(*.aria2) every SEC seconds" description="Save a control file(*.aria2) every SEC seconds" value="value"
        flag "--bt-detach-seed-only" summary="Exclude seed only downloads when counting concurrent active downloads" description="Exclude seed only downloads when counting concurrent active downloads"
        flag "--bt-enable-hook-after-hash-check" summary="Allow hook command invocation after hash check (see -V option) in BitTorrent download" description="Allow hook command invocation after hash check (see -V option) in BitTorrent download"
        flag "--bt-enable-lpd" summary="Enable Local Peer Discovery" description="Enable Local Peer Discovery"
        flag "--bt-exclude-tracker" summary="Comma separated list of BitTorrent tracker's announce URI to remove" description="Comma separated list of BitTorrent tracker's announce URI to remove" value="value"
        flag "--bt-external-ip" summary="Specify the external IP address to use in BitTorrent download and DHT" description="Specify the external IP address to use in BitTorrent download and DHT" value="value"
        flag "--bt-force-encryption" summary="Requires BitTorrent message payload encryption with arc4" description="Requires BitTorrent message payload encryption with arc4"
        flag "--bt-hash-check-seed" summary="If true is given, after hash check using --check-integrity option and file is complete, continue to seed file" description="If true is given, after hash check using --check-integrity option and file is complete, continue to seed file"
        flag "--bt-load-saved-metadata" summary="Before getting torrent metadata from DHT when downloading with magnet link, first try to read file saved by --bt-save-metadata option" description="Before getting torrent metadata from DHT when downloading with magnet link, first try to read file saved by --bt-save-metadata option"
        flag "--bt-lpd-interface" summary="Use given interface for Local Peer Discovery" description="Use given interface for Local Peer Discovery" value="value"
        flag "--bt-max-open-files" summary="Specify maximum number of files to open in multi-file BitTorrent/Metalink downloads globally" description="Specify maximum number of files to open in multi-file BitTorrent/Metalink downloads globally" value="value"
        flag "--bt-max-peers" summary="Specify the maximum number of peers per torrent" description="Specify the maximum number of peers per torrent" value="value"
        flag "--bt-metadata-only" summary="Download metadata only" description="Download metadata only"
        flag "--bt-min-crypto-level" summary="Set minimum level of encryption method" description="Set minimum level of encryption method" value="value"
        flag "--bt-prioritize-piece" summary="Try to download first and last pieces of each file first" description="Try to download first and last pieces of each file first" value="value"
        flag "--bt-remove-unselected-file" summary="Removes the unselected files when download is completed in BitTorrent" description="Removes the unselected files when download is completed in BitTorrent"
        flag "--bt-request-peer-speed-limit" summary="If the whole download speed of every torrent is lower than SPEED, aria2 temporarily increases the number of peers to try for more download speed" description="If the whole download speed of every torrent is lower than SPEED, aria2 temporarily increases the number of peers to try for more download speed" value="value"
        flag "--bt-require-crypto" summary="If true is given, aria2 doesn't accept and establish connection with legacy BitTorrent handshake" description="If true is given, aria2 doesn't accept and establish connection with legacy BitTorrent handshake"
        flag "--bt-save-metadata" summary="Save metadata as .torrent file" description="Save metadata as .torrent file"
        flag "--bt-seed-unverified" summary="Seed previously downloaded files without verifying piece hashes" description="Seed previously downloaded files without verifying piece hashes"
        flag "--bt-stop-timeout" summary="Stop BitTorrent download if download speed is 0 in consecutive SEC seconds" description="Stop BitTorrent download if download speed is 0 in consecutive SEC seconds" value="value"
        flag "--bt-tracker" summary="Comma separated list of additional BitTorrent tracker's announce URI" description="Comma separated list of additional BitTorrent tracker's announce URI" value="value"
        flag "--bt-tracker-connect-timeout" summary="Set the connect timeout in seconds to establish connection to tracker" description="Set the connect timeout in seconds to establish connection to tracker" value="value"
        flag "--bt-tracker-interval" summary="Set the interval in seconds between tracker requests" description="Set the interval in seconds between tracker requests" value="value"
        flag "--bt-tracker-timeout" summary="Set timeout in seconds" description="Set timeout in seconds" value="value"
        flag "--ca-certificate" summary="Use the certificate authorities in FILE to verify the peers" description="Use the certificate authorities in FILE to verify the peers" value="value" action="files"
        flag "--certificate" summary="Use the client certificate in FILE" description="Use the client certificate in FILE" value="value" action="files"
        flag "--check-certificate" summary="Verify the peer using certificates specified in --ca-certificate option" description="Verify the peer using certificates specified in --ca-certificate option"
        flag "--check-integrity" summary="Check file integrity by validating piece hashes or a hash of entire file" description="Check file integrity by validating piece hashes or a hash of entire file" short="-V"
        flag "--checksum" summary="Set checksum" description="Set checksum" value="value"
        flag "--conditional-get" summary="Download file only when the local file is older than remote file" description="Download file only when the local file is older than remote file"
        flag "--conf-path" summary="Change the configuration file path to PATH" description="Change the configuration file path to PATH" value="value" action="files"
        flag "--connect-timeout" summary="Set the connect timeout in seconds to establish connection to HTTP/FTP/proxy server" description="Set the connect timeout in seconds to establish connection to HTTP/FTP/proxy server" value="value"
        flag "--console-log-level" summary="Set log level to output to console" description="Set log level to output to console" value="value"
        flag "--content-disposition-default-utf8" summary="Handle quoted string in Content-Disposition header as UTF-8 instead of ISO-8859-1, for example, the filename parameter, but not the extended version filename*" description="Handle quoted string in Content-Disposition header as UTF-8 instead of ISO-8859-1, for example, the filename parameter, but not the extended version filename*"
        flag "--continue" summary="Continue downloading a partially downloaded file" description="Continue downloading a partially downloaded file" short="-c"
        flag "--daemon" summary="Run as daemon" description="Run as daemon" short="-D"
        flag "--deferred-input" summary="If true is given, aria2 does not read all URIs and options from file specified by -i option at startup, but it reads one by one when it needs later" description="If true is given, aria2 does not read all URIs and options from file specified by -i option at startup, but it reads one by one when it needs later"
        flag "--dht-entry-point" summary="Set host and port as an entry point to IPv4 DHT network" description="Set host and port as an entry point to IPv4 DHT network" value="value"
        flag "--dht-entry-point6" summary="Set host and port as an entry point to IPv6 DHT network" description="Set host and port as an entry point to IPv6 DHT network" value="value"
        flag "--dht-file-path" summary="Change the IPv4 DHT routing table file to PATH" description="Change the IPv4 DHT routing table file to PATH" value="value" action="files"
        flag "--dht-file-path6" summary="Change the IPv6 DHT routing table file to PATH" description="Change the IPv6 DHT routing table file to PATH" value="value" action="files"
        flag "--dht-listen-addr6" summary="Specify address to bind socket for IPv6 DHT" description="Specify address to bind socket for IPv6 DHT" value="value"
        flag "--dht-listen-port" summary="Set UDP listening port used by DHT(IPv4, IPv6) and UDP tracker" description="Set UDP listening port used by DHT(IPv4, IPv6) and UDP tracker" value="value"
        flag "--dht-message-timeout" summary="Set timeout in seconds" description="Set timeout in seconds" value="value"
        flag "--dir" summary="The directory to store the downloaded file" description="The directory to store the downloaded file" short="-d" value="value" action="directories"
        flag "--disable-ipv6" summary="Disable IPv6" description="Disable IPv6"
        flag "--disk-cache" summary="Enable disk cache" description="Enable disk cache" value="value"
        flag "--download-result" summary="This option changes the way \"Download Results\" is formatted" description="This option changes the way \"Download Results\" is formatted" value="value"
        flag "--dry-run" summary="If true is given, aria2 just checks whether the remote file is available and doesn't download data" description="If true is given, aria2 just checks whether the remote file is available and doesn't download data"
        flag "--dscp" summary="Set DSCP value in outgoing IP packets of BitTorrent traffic for QoS" description="Set DSCP value in outgoing IP packets of BitTorrent traffic for QoS" value="value"
        flag "--enable-async-dns6" summary="Enable IPv6 name resolution in asynchronous DNS resolver" description="Enable IPv6 name resolution in asynchronous DNS resolver"
        flag "--enable-color" summary="Enable color output for a terminal" description="Enable color output for a terminal"
        flag "--enable-dht" summary="Enable IPv4 DHT functionality" description="Enable IPv4 DHT functionality"
        flag "--enable-dht6" summary="Enable IPv6 DHT functionality" description="Enable IPv6 DHT functionality"
        flag "--enable-http-keep-alive" summary="Enable HTTP/1.1 persistent connection" description="Enable HTTP/1.1 persistent connection"
        flag "--enable-http-pipelining" summary="Enable HTTP/1.1 pipelining" description="Enable HTTP/1.1 pipelining"
        flag "--enable-mmap" summary="Map files into memory" description="Map files into memory"
        flag "--enable-peer-exchange" summary="Enable Peer Exchange extension" description="Enable Peer Exchange extension"
        flag "--enable-rpc" summary="Enable JSON-RPC/XML-RPC server" description="Enable JSON-RPC/XML-RPC server"
        flag "--event-poll" summary="Specify the method for polling events" description="Specify the method for polling events" value="value"
        flag "--file-allocation" summary="Specify file allocation method" description="Specify file allocation method" value="value"
        flag "--follow-metalink" summary="Controls how Metalink files are handled after download" description="Controls how Metalink files are handled after download" value="value"
        flag "--follow-torrent" summary="Controls how Torrent files are handled after download" description="Controls how Torrent files are handled after download" value="value"
        flag "--force-save" summary="Save download with --save-session option even if the download is completed or removed" description="Save download with --save-session option even if the download is completed or removed"
        flag "--force-sequential" summary="Fetch URIs in the command-line sequentially and download each URI in a separate session" description="Fetch URIs in the command-line sequentially and download each URI in a separate session" short="-Z"
        flag "--ftp-passwd" summary="Set FTP password" description="Set FTP password" value="value"
        flag "--ftp-pasv" summary="Use the passive mode in FTP" description="Use the passive mode in FTP" short="-p"
        flag "--ftp-proxy" summary="Use a proxy server for FTP" description="Use a proxy server for FTP" value="value"
        flag "--ftp-proxy-passwd" summary="Set password for --ftp-proxy" description="Set password for --ftp-proxy" value="value"
        flag "--ftp-proxy-user" summary="Set user for --ftp-proxy" description="Set user for --ftp-proxy" value="value"
        flag "--ftp-reuse-connection" summary="Reuse connection in FTP" description="Reuse connection in FTP"
        flag "--ftp-type" summary="Set FTP transfer type" description="Set FTP transfer type" value="value"
        flag "--ftp-user" summary="Set FTP user" description="Set FTP user" value="value"
        flag "--gid" summary="Set GID manually" description="Set GID manually" value="value"
        flag "--hash-check-only" summary="If true is given, after hash check using --check-integrity option, abort download whether or not download is complete" description="If true is given, after hash check using --check-integrity option, abort download whether or not download is complete"
        flag "--header" summary="Append HEADER to HTTP request header" description="Append HEADER to HTTP request header" value="value"
        flag "--help" summary="Print usage and exit" description="Print usage and exit" short="-h" value="value"
        flag "--http-accept-gzip" summary="Send 'Accept-Encoding: deflate, gzip' request header and inflate response if remote server responds with 'Content-Encoding: gzip' or 'Content-Encoding: deflate'" description="Send 'Accept-Encoding: deflate, gzip' request header and inflate response if remote server responds with 'Content-Encoding: gzip' or 'Content-Encoding: deflate'"
        flag "--http-auth-challenge" summary="Send HTTP authorization header only when it is requested by the server" description="Send HTTP authorization header only when it is requested by the server"
        flag "--http-no-cache" summary="Send Cache-Control: no-cache and Pragma: no-cache header to avoid cached content" description="Send Cache-Control: no-cache and Pragma: no-cache header to avoid cached content"
        flag "--http-passwd" summary="Set HTTP password" description="Set HTTP password" value="value"
        flag "--http-proxy" summary="Use a proxy server for HTTP" description="Use a proxy server for HTTP" value="value"
        flag "--http-proxy-passwd" summary="Set password for --http-proxy" description="Set password for --http-proxy" value="value"
        flag "--http-proxy-user" summary="Set user for --http-proxy" description="Set user for --http-proxy" value="value"
        flag "--http-user" summary="Set HTTP user" description="Set HTTP user" value="value"
        flag "--https-proxy" summary="Use a proxy server for HTTPS" description="Use a proxy server for HTTPS" value="value"
        flag "--https-proxy-passwd" summary="Set password for --https-proxy" description="Set password for --https-proxy" value="value"
        flag "--https-proxy-user" summary="Set user for --https-proxy" description="Set user for --https-proxy" value="value"
        flag "--human-readable" summary="Print sizes and speed in human readable format (e.g., 1.2Ki, 3.4Mi) in the console readout" description="Print sizes and speed in human readable format (e.g., 1.2Ki, 3.4Mi) in the console readout"
        flag "--index-out" summary="Set file path for file with index=INDEX" description="Set file path for file with index=INDEX" short="-O" value="value" repeatable=#true
        flag "--input-file" summary="Downloads URIs found in FILE" description="Downloads URIs found in FILE" short="-i" value="value" action="files"
        flag "--interface" summary="Bind sockets to given interface" description="Bind sockets to given interface" value="value"
        flag "--keep-unfinished-download-result" summary="Keep unfinished download results even if doing so exceeds --max-download-result" description="Keep unfinished download results even if doing so exceeds --max-download-result"
        flag "--listen-port" summary="Set TCP port number for BitTorrent downloads" description="Set TCP port number for BitTorrent downloads" value="value"
        flag "--load-cookies" summary="Load Cookies from FILE using the Firefox3 format and Mozilla/Firefox(1.x/2.x)/Netscape format" description="Load Cookies from FILE using the Firefox3 format and Mozilla/Firefox(1.x/2.x)/Netscape format" value="value" action="files"
        flag "--log" summary="The file name of the log file" description="The file name of the log file" short="-l" value="value" action="files"
        flag "--log-level" summary="Set log level to output to file specified using --log option" description="Set log level to output to file specified using --log option" value="value"
        flag "--lowest-speed-limit" summary="Close connection if download speed is lower than or equal to this value(bytes per sec)" description="Close connection if download speed is lower than or equal to this value(bytes per sec)" value="value"
        flag "--max-concurrent-downloads" summary="Set maximum number of parallel downloads for every static (HTTP/FTP) URL, torrent and metalink" description="Set maximum number of parallel downloads for every static (HTTP/FTP) URL, torrent and metalink" short="-j" value="value"
        flag "--max-connection-per-server" summary="The maximum number of connections to one server for each download" description="The maximum number of connections to one server for each download" short="-x" value="value"
        flag "--max-download-limit" summary="Set max download speed per each download in bytes/sec" description="Set max download speed per each download in bytes/sec" value="value"
        flag "--max-download-result" summary="Set maximum number of download result kept in memory" description="Set maximum number of download result kept in memory" value="value"
        flag "--max-file-not-found" summary="If aria2 receives `file not found' status from the remote HTTP/FTP servers NUM times without getting a single byte, then force the download to fail" description="If aria2 receives `file not found' status from the remote HTTP/FTP servers NUM times without getting a single byte, then force the download to fail" value="value"
        flag "--max-mmap-limit" summary="Set the maximum file size to enable mmap" description="Set the maximum file size to enable mmap" value="value"
        flag "--max-overall-download-limit" summary="Set max overall download speed in bytes/sec" description="Set max overall download speed in bytes/sec" value="value"
        flag "--max-overall-upload-limit" summary="Set max overall upload speed in bytes/sec" description="Set max overall upload speed in bytes/sec" value="value"
        flag "--max-resume-failure-tries" summary="When used with --always-resume=false, aria2 downloads file from scratch when aria2 detects N number of URIs that does not support resume" description="When used with --always-resume=false, aria2 downloads file from scratch when aria2 detects N number of URIs that does not support resume" value="value"
        flag "--max-tries" summary="Set number of tries" description="Set number of tries" short="-m" value="value"
        flag "--max-upload-limit" summary="Set max upload speed per each torrent in bytes/sec" description="Set max upload speed per each torrent in bytes/sec" short="-u" value="value"
        flag "--metalink-base-uri" summary="Specify base URI to resolve relative URI in metalink:url and metalink:metaurl element in a metalink file stored in local disk" description="Specify base URI to resolve relative URI in metalink:url and metalink:metaurl element in a metalink file stored in local disk" value="value"
        flag "--metalink-enable-unique-protocol" summary="If true is given and several protocols are available for a mirror in a metalink file, aria2 uses one of them" description="If true is given and several protocols are available for a mirror in a metalink file, aria2 uses one of them"
        flag "--metalink-file" summary="The file path to the .meta4 and .metalink file" description="The file path to the .meta4 and .metalink file" short="-M" value="value" action="files"
        flag "--metalink-language" summary="The language of the file to download" description="The language of the file to download" value="value"
        flag "--metalink-location" summary="The location of the preferred server" description="The location of the preferred server" value="value"
        flag "--metalink-os" summary="The operating system of the file to download" description="The operating system of the file to download" value="value"
        flag "--metalink-preferred-protocol" summary="Specify preferred protocol" description="Specify preferred protocol" value="value"
        flag "--metalink-version" summary="The version of the file to download" description="The version of the file to download" value="value"
        flag "--min-split-size" summary="aria2 does not split less than 2*SIZE byte range" description="aria2 does not split less than 2*SIZE byte range" short="-k" value="value"
        flag "--min-tls-version" summary="Specify minimum SSL/TLS version to enable" description="Specify minimum SSL/TLS version to enable" value="value"
        flag "--multiple-interface" summary="Comma separated list of interfaces to bind sockets to" description="Comma separated list of interfaces to bind sockets to" value="value"
        flag "--netrc-path" summary="Specify the path to the netrc file" description="Specify the path to the netrc file" value="value" action="files"
        flag "--no-conf" summary="Disable loading aria2.conf file" description="Disable loading aria2.conf file"
        flag "--no-file-allocation-limit" summary="No file allocation is made for files whose size is smaller than SIZE" description="No file allocation is made for files whose size is smaller than SIZE" value="value"
        flag "--no-netrc" summary="Disables netrc support" description="Disables netrc support" short="-n"
        flag "--no-proxy" summary="Specify comma separated hostnames, domains or network address with or without CIDR block where proxy should not be used" description="Specify comma separated hostnames, domains or network address with or without CIDR block where proxy should not be used" value="value"
        flag "--no-want-digest-header" summary="Whether to disable Want-Digest header when doing requests" description="Whether to disable Want-Digest header when doing requests"
        flag "--on-bt-download-complete" summary="For BitTorrent, a command specified in --on-download-complete is called after download completed and seeding is over" description="For BitTorrent, a command specified in --on-download-complete is called after download completed and seeding is over" value="value" action="files"
        flag "--on-download-complete" summary="Set the command to be executed after download completed" description="Set the command to be executed after download completed" value="value" action="files"
        flag "--on-download-error" summary="Set the command to be executed after download aborted due to error" description="Set the command to be executed after download aborted due to error" value="value" action="files"
        flag "--on-download-pause" summary="Set the command to be executed after download was paused" description="Set the command to be executed after download was paused" value="value" action="files"
        flag "--on-download-start" summary="Set the command to be executed after download got started" description="Set the command to be executed after download got started" value="value" action="files"
        flag "--on-download-stop" summary="Set the command to be executed after download stopped" description="Set the command to be executed after download stopped" value="value" action="files"
        flag "--optimize-concurrent-downloads" summary="Optimizes the number of concurrent downloads according to the bandwidth available" description="Optimizes the number of concurrent downloads according to the bandwidth available"
        flag "--out" summary="The file name of the downloaded file" description="The file name of the downloaded file" short="-o" value="value" action="files"
        flag "--parameterized-uri" summary="Enable parameterized URI support" description="Enable parameterized URI support" short="-P"
        flag "--pause" summary="Pause download after added" description="Pause download after added"
        flag "--pause-metadata" summary="Pause downloads created as a result of metadata download" description="Pause downloads created as a result of metadata download"
        flag "--peer-agent" summary="Set client reported during Extended torrent handshakes" description="Set client reported during Extended torrent handshakes" value="value"
        flag "--peer-id-prefix" summary="Specify the prefix of peer ID" description="Specify the prefix of peer ID" value="value"
        flag "--piece-length" summary="Set a piece length for HTTP/FTP downloads" description="Set a piece length for HTTP/FTP downloads" value="value"
        flag "--private-key" summary="Use the private key in FILE" description="Use the private key in FILE" value="value" action="files"
        flag "--proxy-method" summary="Set the method to use in proxy request" description="Set the method to use in proxy request" value="value"
        flag "--quiet" summary="Make aria2 quiet(no console output)" description="Make aria2 quiet(no console output)" short="-q"
        flag "--realtime-chunk-checksum" summary="Validate chunk of data by calculating checksum while downloading a file if chunk checksums are provided" description="Validate chunk of data by calculating checksum while downloading a file if chunk checksums are provided"
        flag "--referer" summary="Set an http referrrer (Referer)" description="Set an http referrrer (Referer)" value="value"
        flag "--remote-time" summary="Retrieve timestamp of the remote file from the remote HTTP/FTP server and if it is available, apply it to the local file" description="Retrieve timestamp of the remote file from the remote HTTP/FTP server and if it is available, apply it to the local file" short="-R"
        flag "--remove-control-file" summary="Remove control file before download" description="Remove control file before download"
        flag "--retry-wait" summary="Set the seconds to wait between retries" description="Set the seconds to wait between retries" value="value"
        flag "--reuse-uri" summary="Reuse already used URIs if no unused URIs are left" description="Reuse already used URIs if no unused URIs are left"
        flag "--rlimit-nofile" summary="Set the soft limit of open file descriptors" description="Set the soft limit of open file descriptors" value="value"
        flag "--rpc-allow-origin-all" summary="Add Access-Control-Allow-Origin header field with value '*' to the RPC response" description="Add Access-Control-Allow-Origin header field with value '*' to the RPC response"
        flag "--rpc-certificate" summary="Use the certificate in FILE for RPC server" description="Use the certificate in FILE for RPC server" value="value" action="files"
        flag "--rpc-listen-all" summary="Listen incoming JSON-RPC/XML-RPC requests on all network interfaces" description="Listen incoming JSON-RPC/XML-RPC requests on all network interfaces"
        flag "--rpc-listen-port" summary="Specify a port number for JSON-RPC/XML-RPC server to listen to" description="Specify a port number for JSON-RPC/XML-RPC server to listen to" value="value"
        flag "--rpc-max-request-size" summary="Set max size of JSON-RPC/XML-RPC request" description="Set max size of JSON-RPC/XML-RPC request" value="value"
        flag "--rpc-passwd" summary="Set JSON-RPC/XML-RPC password" description="Set JSON-RPC/XML-RPC password" value="value"
        flag "--rpc-private-key" summary="Use the private key in FILE for RPC server" description="Use the private key in FILE for RPC server" value="value" action="files"
        flag "--rpc-save-upload-metadata" summary="Save the uploaded torrent or metalink metadata in the directory specified by --dir option" description="Save the uploaded torrent or metalink metadata in the directory specified by --dir option"
        flag "--rpc-secret" summary="Set RPC secret authorization token" description="Set RPC secret authorization token" value="value"
        flag "--rpc-secure" summary="RPC transport will be encrypted by SSL/TLS" description="RPC transport will be encrypted by SSL/TLS"
        flag "--rpc-user" summary="Set JSON-RPC/XML-RPC user" description="Set JSON-RPC/XML-RPC user" value="value"
        flag "--save-cookies" summary="Save Cookies to FILE in Mozilla/Firefox(1.x/2.x)/ Netscape format" description="Save Cookies to FILE in Mozilla/Firefox(1.x/2.x)/ Netscape format" value="value" action="files"
        flag "--save-not-found" summary="Save download with --save-session option even if the file was not found on the server" description="Save download with --save-session option even if the file was not found on the server"
        flag "--save-session" summary="Save error/unfinished downloads to FILE on exit" description="Save error/unfinished downloads to FILE on exit" value="value" action="files"
        flag "--save-session-interval" summary="Save error/unfinished downloads to a file specified by --save-session option every SEC seconds" description="Save error/unfinished downloads to a file specified by --save-session option every SEC seconds" value="value"
        flag "--seed-ratio" summary="Specify share ratio" description="Specify share ratio" value="value"
        flag "--seed-time" summary="Specify seeding time in (fractional) minutes" description="Specify seeding time in (fractional) minutes" value="value"
        flag "--select-file" summary="Set file to download by specifying its index" description="Set file to download by specifying its index" value="value"
        flag "--server-stat-if" summary="Specify the filename to load performance profile of the servers" description="Specify the filename to load performance profile of the servers" value="value" action="files"
        flag "--server-stat-of" summary="Specify the filename to which performance profile of the servers is saved" description="Specify the filename to which performance profile of the servers is saved" value="value" action="files"
        flag "--server-stat-timeout" summary="Specifies timeout in seconds to invalidate performance profile of the servers since the last contact to them" description="Specifies timeout in seconds to invalidate performance profile of the servers since the last contact to them" value="value"
        flag "--show-console-readout" summary="Show console readout" description="Show console readout"
        flag "--show-files" summary="Print file listing of .torrent, .meta4 and .metalink file and exit" description="Print file listing of .torrent, .meta4 and .metalink file and exit" short="-S"
        flag "--socket-recv-buffer-size" summary="Set the maximum socket receive buffer in bytes" description="Set the maximum socket receive buffer in bytes" value="value"
        flag "--split" summary="Download a file using N connections" description="Download a file using N connections" short="-s" value="value"
        flag "--ssh-host-key-md" summary="Set checksum for SSH host public key" description="Set checksum for SSH host public key" value="value"
        flag "--stderr" summary="Redirect all console output that would be otherwise printed in stdout to stderr" description="Redirect all console output that would be otherwise printed in stdout to stderr"
        flag "--stop" summary="Stop application after SEC seconds has passed" description="Stop application after SEC seconds has passed" value="value"
        flag "--stop-with-process" summary="Stop application when process PID is not running" description="Stop application when process PID is not running" value="value"
        flag "--stream-piece-selector" summary="Specify piece selection algorithm used in HTTP/FTP download" description="Specify piece selection algorithm used in HTTP/FTP download" value="value"
        flag "--summary-interval" summary="Set interval to output download progress summary" description="Set interval to output download progress summary" value="value"
        flag "--timeout" summary="Set timeout in seconds" description="Set timeout in seconds" short="-t" value="value"
        flag "--torrent-file" summary="The path to the .torrent file" description="The path to the .torrent file" short="-T" value="value" action="files"
        flag "--truncate-console-readout" summary="Truncate console readout to fit in a single line" description="Truncate console readout to fit in a single line"
        flag "--uri-selector" summary="Specify URI selection algorithm" description="Specify URI selection algorithm" value="value"
        flag "--use-head" summary="Use HEAD method for the first request to the HTTP server" description="Use HEAD method for the first request to the HTTP server"
        flag "--user-agent" summary="Set user agent for http(s) downloads" description="Set user agent for http(s) downloads" short="-U" value="value"
        flag "--version" summary="Print the version number and exit" description="Print the version number and exit" short="-v"
    }
}

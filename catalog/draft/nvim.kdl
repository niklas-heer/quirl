catalog "nvim-draft" {
    provenance author="Carapace contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "nvim" summary="edit text" description="edit text" {
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "--api-info" summary="Write msgpack-encoded API metadata to stdout" description="Write msgpack-encoded API metadata to stdout"
        flag "--cmd" summary="Execute <cmd> before any config" description="Execute <cmd> before any config" value="value"
        flag "--embed" summary="Use stdin/stdout as a msgpack-rpc channel" description="Use stdin/stdout as a msgpack-rpc channel"
        flag "--headless" summary="Don't start a user interface" description="Don't start a user interface"
        flag "--help" summary="Print this help message" description="Print this help message" short="-h"
        flag "--listen" summary="Serve RPC API from this address" description="Serve RPC API from this address" value="value"
        flag "--noplugin" summary="Don't load plugins" description="Don't load plugins"
        flag "--startuptime" summary="Write startup timing messages to <file>" description="Write startup timing messages to <file>" value="value" action="files"
        flag "--version" summary="Print version information" description="Print version information" short="-v"
        flag "-M" summary="Modifications in text not allowed" description="Modifications in text not allowed"
        flag "-O" summary="Open N vertical windows (default: one per file)" description="Open N vertical windows (default: one per file)" value="value"
        flag "-R" summary="Read-only mode" description="Read-only mode"
        flag "-S" summary="Source <session> after loading the first file" description="Source <session> after loading the first file" value="value" action="files"
        flag "-V" summary="Verbose [level][file]" description="Verbose [level][file]" value="value"
        flag "-Z" summary="Restricted mode" description="Restricted mode"
        flag "-b" summary="Binary mode" description="Binary mode"
        flag "-d" summary="Diff mode" description="Diff mode"
        flag "-i" summary="Use this shada file" description="Use this shada file" value="value" action="files"
        flag "-m" summary="Modifications (writing files) not allowed" description="Modifications (writing files) not allowed"
        flag "-n" summary="No swap file, use memory only" description="No swap file, use memory only"
        flag "-o" summary="Open N windows (default: one per file)" description="Open N windows (default: one per file)" value="value"
        flag "-p" summary="Open N tab pages (default: one per file)" description="Open N tab pages (default: one per file)" value="value"
        flag "-r" summary="Recover edit state for this file" description="Recover edit state for this file" value="value"
        flag "-s" summary="Read Normal mode commands from <scriptin>" description="Read Normal mode commands from <scriptin>" value="value"
        flag "-u" summary="Use this config file" description="Use this config file" value="value" action="files"
    }
}

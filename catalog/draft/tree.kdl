catalog "tree-draft" {
    provenance author="Carapace contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "tree" summary="list contents of directories in a tree-like format" description="list contents of directories in a tree-like format" {
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "--acl" summary="Print permissions with a + if an ACL is present." description="Print permissions with a + if an ACL is present."
        flag "--authority" summary="Set OSC 8 hyperlink authority/hostname." description="Set OSC 8 hyperlink authority/hostname." value="value"
        flag "--charset" summary="Use charset X for terminal/HTML and indentation line output." description="Use charset X for terminal/HTML and indentation line output." value="value"
        flag "--compress" summary="Compress indentation lines." description="Compress indentation lines." value="value"
        flag "--condense" summary="Condense directory singletons to a single line of output." description="Condense directory singletons to a single line of output."
        flag "--device" summary="Print device ID number to which each file belongs." description="Print device ID number to which each file belongs."
        flag "--dirsfirst" summary="List directories before files (-U disables)." description="List directories before files (-U disables)."
        flag "--du" summary="Compute size of directories by their contents." description="Compute size of directories by their contents."
        flag "--fflinks" summary="Process link information when using --fromfile." description="Process link information when using --fromfile."
        flag "--filelimit" summary="Do not descend dirs with more than # files in them." description="Do not descend dirs with more than # files in them." value="value"
        flag "--filesfirst" summary="List files before directories (-U disables)." description="List files before directories (-U disables)."
        flag "--fromfile" summary="Reads paths from files (.=stdin)" description="Reads paths from files (.=stdin)"
        flag "--fromtabfile" summary="Reads trees from tab indented files (.=stdin)" description="Reads trees from tab indented files (.=stdin)"
        flag "--gitfile" summary="Explicitly read a gitignore file." description="Explicitly read a gitignore file." value="value" action="files"
        flag "--gitignore" summary="Filter by using .gitignore files." description="Filter by using .gitignore files."
        flag "--help" summary="Print usage and this help message and exit." description="Print usage and this help message and exit."
        flag "--hintro" summary="Use file X as the HTML intro." description="Use file X as the HTML intro." value="value" action="files"
        flag "--houtro" summary="Use file X as the HTML outro." description="Use file X as the HTML outro." value="value" action="files"
        flag "--hyperlink" summary="Turn on OSC 8 terminal hyperlinks." description="Turn on OSC 8 terminal hyperlinks."
        flag "--ignore-case" summary="Ignore case when pattern matching." description="Ignore case when pattern matching."
        flag "--info" summary="Print information about files found in .info files." description="Print information about files found in .info files."
        flag "--infofile" summary="Explicitly read info file." description="Explicitly read info file." value="value" action="files"
        flag "--inodes" summary="Print inode number of each file." description="Print inode number of each file."
        flag "--matchdirs" summary="Include directory names in -P pattern matching." description="Include directory names in -P pattern matching."
        flag "--metafirst" summary="Print meta-data at the beginning of each line." description="Print meta-data at the beginning of each line."
        flag "--nolinks" summary="Turn off hyperlinks in HTML output." description="Turn off hyperlinks in HTML output."
        flag "--noreport" summary="Turn off file/directory count at end of tree listing." description="Turn off file/directory count at end of tree listing."
        flag "--opt-toggle" summary="Enable option toggling." description="Enable option toggling."
        flag "--prune" summary="Prune empty directories from the output." description="Prune empty directories from the output."
        flag "--scheme" summary="Set OSC 8 hyperlink scheme, default file://" description="Set OSC 8 hyperlink scheme, default file://" value="value"
        flag "--selinux" summary="Print the selinux security label if present." description="Print the selinux security label if present."
        flag "--si" summary="Like -h, but use in SI units (powers of 1000)." description="Like -h, but use in SI units (powers of 1000)."
        flag "--sort" summary="Select sort: name,version,size,mtime,ctime,none." description="Select sort: name,version,size,mtime,ctime,none." value="value"
        flag "--timefmt" summary="Print and format time according to the format fmt." description="Print and format time according to the format fmt." value="value"
        flag "--version" summary="Print version and exit." description="Print version and exit."
        flag "-A" summary="Print ANSI lines graphic indentation lines." description="Print ANSI lines graphic indentation lines."
        flag "-C" summary="Turn colorization on always." description="Turn colorization on always."
        flag "-D" summary="Print the date of last modification or (-c) status change." description="Print the date of last modification or (-c) status change."
        flag "-F" summary="Appends '/', '=', '*', '@', '|' or '>' as per ls -F." description="Appends '/', '=', '*', '@', '|' or '>' as per ls -F."
        flag "-H" summary="Prints out HTML format with baseHREF as top directory." description="Prints out HTML format with baseHREF as top directory." value="value"
        flag "-I" summary="Do not list files that match the given pattern." description="Do not list files that match the given pattern." value="value"
        flag "-J" summary="Prints out an JSON representation of the tree." description="Prints out an JSON representation of the tree."
        flag "-L" summary="Descend only level directories deep." description="Descend only level directories deep." value="value"
        flag "-N" summary="Print non-printable characters as is." description="Print non-printable characters as is."
        flag "-P" summary="List only those files that match the pattern given." description="List only those files that match the pattern given." value="value"
        flag "-Q" summary="Quote filenames with double quotes." description="Quote filenames with double quotes."
        flag "-R" summary="Rerun tree when max dir level reached." description="Rerun tree when max dir level reached."
        flag "-S" summary="Print with CP437 (console) graphics indentation lines." description="Print with CP437 (console) graphics indentation lines."
        flag "-T" summary="Replace the default HTML title and H1 header with string." description="Replace the default HTML title and H1 header with string." value="value"
        flag "-U" summary="Leave files unsorted." description="Leave files unsorted."
        flag "-X" summary="Prints out an XML representation of the tree." description="Prints out an XML representation of the tree."
        flag "-a" summary="All files are listed." description="All files are listed."
        flag "-c" summary="Sort files by last status change time." description="Sort files by last status change time."
        flag "-d" summary="List directories only." description="List directories only."
        flag "-f" summary="Print the full path prefix for each file." description="Print the full path prefix for each file."
        flag "-g" summary="Displays file group owner or GID number." description="Displays file group owner or GID number."
        flag "-h" summary="Print the size in a more human readable way." description="Print the size in a more human readable way."
        flag "-i" summary="Don't print indentation lines." description="Don't print indentation lines."
        flag "-l" summary="Follow symbolic links like directories." description="Follow symbolic links like directories."
        flag "-n" summary="Turn colorization off always (-C overrides)." description="Turn colorization off always (-C overrides)."
        flag "-o" summary="Output to file instead of stdout." description="Output to file instead of stdout." value="value" action="files"
        flag "-p" summary="Print the protections for each file." description="Print the protections for each file."
        flag "-q" summary="Print non-printable characters as '?'." description="Print non-printable characters as '?'."
        flag "-r" summary="Reverse the order of the sort." description="Reverse the order of the sort."
        flag "-s" summary="Print the size in bytes of each file." description="Print the size in bytes of each file."
        flag "-t" summary="Sort files by last modification time." description="Sort files by last modification time."
        flag "-u" summary="Displays file owner or UID number." description="Displays file owner or UID number."
        flag "-v" summary="Sort files alphanumerically by version." description="Sort files alphanumerically by version."
        flag "-x" summary="Stay on current filesystem only." description="Stay on current filesystem only."
    }
}

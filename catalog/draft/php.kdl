catalog "php-draft" {
    provenance author="Carapace contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "php" summary="PHP Command Line Interface" description="PHP Command Line Interface" {
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "--ini" summary="Show configuration file names" description="Show configuration file names"
        flag "--rc" summary="Show information about class <name>" description="Show information about class <name>" value="value"
        flag "--re" summary="Show information about extension <name>" description="Show information about extension <name>" value="value"
        flag "--rf" summary="Show information about function <name>" description="Show information about function <name>" value="value"
        flag "--ri" summary="Show configuration for extension <name>" description="Show configuration for extension <name>" value="value"
        flag "--rz" summary="Show information about Zend extension <name>" description="Show information about Zend extension <name>" value="value"
        flag "-B" summary="Run PHP <begin_code> before processing input lines" description="Run PHP <begin_code> before processing input lines" value="value"
        flag "-E" summary="Run PHP <end_code> after processing all input lines" description="Run PHP <end_code> after processing all input lines" value="value"
        flag "-F" summary="Parse and execute <file> for every input line" description="Parse and execute <file> for every input line" value="value" action="files"
        flag "-H" summary="Hide any passed arguments from external tools" description="Hide any passed arguments from external tools"
        flag "-R" summary="Run PHP <code> for every input line" description="Run PHP <code> for every input line" value="value"
        flag "-S" summary="Run with built-in web server" description="Run with built-in web server"
        flag "-a" summary="Run as interactive shell (requires readline extension)" description="Run as interactive shell (requires readline extension)"
        flag "-c" summary="Look for php.ini file in this directory" description="Look for php.ini file in this directory"
        flag "-d" summary="Define INI entry foo with value 'bar'" description="Define INI entry foo with value 'bar'" value="value"
        flag "-e" summary="Generate extended information for debugger/profiler" description="Generate extended information for debugger/profiler"
        flag "-f" summary="Parse and execute <file>" description="Parse and execute <file>" value="value" action="files"
        flag "-h" summary="This help" description="This help"
        flag "-i" summary="PHP information" description="PHP information"
        flag "-l" summary="Syntax check only (lint)" description="Syntax check only (lint)"
        flag "-m" summary="Show compiled in modules" description="Show compiled in modules"
        flag "-n" summary="No configuration (ini) files will be used" description="No configuration (ini) files will be used"
        flag "-r" summary="Run PHP <code> without using script tags <?..?>" description="Run PHP <code> without using script tags <?..?>" value="value"
        flag "-s" summary="Output HTML syntax highlighted source" description="Output HTML syntax highlighted source"
        flag "-t" summary="Specify document root <docroot> for built-in web server" description="Specify document root <docroot> for built-in web server" value="value" action="directories"
        flag "-v" summary="Version number" description="Version number"
        flag "-w" summary="Output source with stripped comments and whitespace" description="Output source with stripped comments and whitespace"
        flag "-z" summary="Load Zend extension <file>" description="Load Zend extension <file>" value="value" action="files"
    }
}

catalog "helix-draft" {
    provenance author="Carapace contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "helix" summary="A post-modern text editor" description="A post-modern text editor" {
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "--config" summary="Specifies a file to use for configuration" description="Specifies a file to use for configuration" short="-c" value="value" action="files"
        flag "--grammar" summary="Fetches or builds tree-sitter grammars listed in languages.toml" description="Fetches or builds tree-sitter grammars listed in languages.toml" short="-g" value="value"
        flag "--health" summary="Checks for potential errors in editor setup" description="Checks for potential errors in editor setup" value="value"
        flag "--help" summary="Prints help information" description="Prints help information" short="-h"
        flag "--hsplit" summary="Splits all given files horizontally into different windows" description="Splits all given files horizontally into different windows"
        flag "--log" summary="Specifies a file to use for logging" description="Specifies a file to use for logging" value="value" action="files"
        flag "--tutor" summary="Loads the tutorial" description="Loads the tutorial"
        flag "--version" summary="Prints version information" description="Prints version information" short="-V"
        flag "--vsplit" summary="Splits all given files vertically into different windows" description="Splits all given files vertically into different windows"
        flag "--working-dir" summary="Specify an initial working directory" description="Specify an initial working directory" short="-w" value="value" action="directories"
        flag "-v" summary="Increases logging verbosity each use for up to 3 times" description="Increases logging verbosity each use for up to 3 times" repeatable=#true
    }
}

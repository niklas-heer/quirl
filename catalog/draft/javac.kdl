catalog "javac-draft" {
    provenance author="Carapace contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "javac" summary="Reads Java class and interface definitions and compiles them into bytecode and class files" description="Reads Java class and interface definitions and compiles them into bytecode and class files" {
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "--add-modules" summary="Root modules to resolve in addition to the initial modules" description="Root modules to resolve in addition to the initial modules" value="value"
        flag "--boot-class-path" summary="Override location of bootstrap class files" description="Override location of bootstrap class files" value="value" action="files"
        flag "--class-path" summary="Specify where to find user class files and annotation processors" description="Specify where to find user class files and annotation processors" value="value" action="files"
        flag "--cp" summary="Specify where to find user class files and annotation processors" description="Specify where to find user class files and annotation processors" value="value" action="files"
        flag "--deprecation" summary="Output source locations where deprecated APIs are used" description="Output source locations where deprecated APIs are used"
        flag "--enable-preview" summary="Enable preview languge features" description="Enable preview languge features"
        flag "--encoding" summary="Specify character encoding used by source files" description="Specify character encoding used by source files" value="value"
        flag "--endorseddirs" summary="Override location of endorsed standards path" description="Override location of endorsed standards path" value="value" action="directories"
        flag "--extdirs" summary="Override location of installed extensions" description="Override location of installed extensions" value="value" action="directories"
        flag "--help" summary="Print help message" description="Print help message"
        flag "--help-extra" summary="Print help on extra options" description="Print help on extra options" short="-X"
        flag "--implicit" summary="Specify whether or not to generate class files for implicitly referenced files" description="Specify whether or not to generate class files for implicitly referenced files" value="value"
        flag "--limit-modules" summary="Limit the universe of observable modules" description="Limit the universe of observable modules" value="value"
        flag "--module" summary="Compile only the specified module" description="Compile only the specified module" value="value"
        flag "--module-path" summary="Root modules to resolve in addition to the initial modules" description="Root modules to resolve in addition to the initial modules" short="-p" value="value" action="directories"
        flag "--module-source-path" summary="Specify where to find input source files for multiple modules" description="Specify where to find input source files for multiple modules" value="value" action="directories"
        flag "--module-version" summary="Specify version of modules that are being compiled" description="Specify version of modules that are being compiled" value="value"
        flag "--nowarn" summary="Generate no warnings" description="Generate no warnings"
        flag "--parameters" summary="Generate metadata for reflection on method parameters" description="Generate metadata for reflection on method parameters"
        flag "--proc" summary="Control whether annotation processing and/or compilation is done." description="Control whether annotation processing and/or compilation is done." value="value"
        flag "--processor" summary="Names of the annotation processors to run; bypasses default discovery process" description="Names of the annotation processors to run; bypasses default discovery process" value="value"
        flag "--processor-module-path" summary="Specify a module path where to find annotation processors" description="Specify a module path where to find annotation processors" value="value" action="directories"
        flag "--processor-path" summary="Specify where to find annotation processors" description="Specify where to find annotation processors" value="value" action="directories"
        flag "--profile" summary="Check that API used is available in the specified profile" description="Check that API used is available in the specified profile" value="value"
        flag "--release" summary="Compile for a specific VM version" description="Compile for a specific VM version" value="value"
        flag "--source" summary="Provide source compatibility with specified release" description="Provide source compatibility with specified release" value="value"
        flag "--source-path" summary="Specify where to find input source files" description="Specify where to find input source files" value="value" action="directories"
        flag "--system" summary="Override location of system modules" description="Override location of system modules" value="value"
        flag "--target" summary="Generate class files for specific VM version" description="Generate class files for specific VM version" value="value"
        flag "--upgrade-module-path" summary="Override location of upgradeable modules" description="Override location of upgradeable modules" value="value" action="directories"
        flag "--verbose" summary="Output messages about what the compiler is doing" description="Output messages about what the compiler is doing"
        flag "--version" summary="Version information" description="Version information"
        flag "-A" summary="Options to pass to annotation processors" description="Options to pass to annotation processors"
        flag "-J" summary="Pass flag directly to the runtime system" description="Pass flag directly to the runtime system"
        flag "-d" summary="Specify where to place generated class files" description="Specify where to place generated class files"
        flag "-g" summary="Generates all debugging information" description="Generates all debugging information" value="value"
        flag "-h" summary="Specify where to place generated native header files" description="Specify where to place generated native header files"
        flag "-s" summary="Specify where to place generated source files" description="Specify where to place generated source files"
    }
}

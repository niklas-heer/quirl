catalog "pigz-draft" {
    provenance author="Carapace contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "pigz" summary="compress or expand files" description="compress or expand files" {
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "--11" summary="Compression level 11, zopfli" description="Compression level 11, zopfli"
        flag "--alias" summary="Use xxx as the name for any --zip entry from stdin" description="Use xxx as the name for any --zip entry from stdin" short="-A" value="value"
        flag "--best" summary="Compression levels 9" description="Compression levels 9"
        flag "--blocksize" summary="Set compression block size to mmmK (default 128K)" description="Set compression block size to mmmK (default 128K)" short="-b" value="value"
        flag "--comment" summary="Put comment ccc in the gzip or zip header" description="Put comment ccc in the gzip or zip header" short="-C" value="value"
        flag "--decompress" summary="Decompress the compressed input" description="Decompress the compressed input" short="-d"
        flag "--fast" summary="Compression levels 1" description="Compression levels 1"
        flag "--first" summary="Do iterations first, before block split for -11" description="Do iterations first, before block split for -11" short="-F"
        flag "--force" summary="Force overwrite, compress .gz, links, and to terminal" description="Force overwrite, compress .gz, links, and to terminal" short="-f"
        flag "--help" summary="Display a help screen and quit" description="Display a help screen and quit" short="-h"
        flag "--huffman" summary="Use only Huffman coding for compression" description="Use only Huffman coding for compression" short="-H"
        flag "--independent" summary="Compress blocks independently for damage recovery" description="Compress blocks independently for damage recovery" short="-i"
        flag "--iterations" summary="Number of iterations for -11 optimization" description="Number of iterations for -11 optimization" short="-I" value="value"
        flag "--keep" summary="Do not delete original file after processing" description="Do not delete original file after processing" short="-k"
        flag "--license" summary="Display the pigz license and quit" description="Display the pigz license and quit" short="-L"
        flag "--list" summary="List the contents of the compressed input" description="List the contents of the compressed input" short="-l"
        flag "--maxsplits" summary="Maximum number of split blocks for -11" description="Maximum number of split blocks for -11" short="-J" value="value"
        flag "--name" summary="Store or restore file name and mod time" description="Store or restore file name and mod time" short="-N"
        flag "--no-name" summary="Do not store or restore file name or mod time" description="Do not store or restore file name or mod time" short="-n"
        flag "--no-time" summary="Do not store or restore mod time" description="Do not store or restore mod time" short="-m"
        flag "--oneblock" summary="Do not split into smaller blocks for -11" description="Do not split into smaller blocks for -11" short="-O"
        flag "--processes" summary="Allow up to n compression threads (default is the" description="Allow up to n compression threads (default is the" short="-p" value="value"
        flag "--quiet" summary="Print no messages, even on error" description="Print no messages, even on error" short="-q"
        flag "--recursive" summary="Process the contents of all subdirectories" description="Process the contents of all subdirectories" short="-r"
        flag "--rle" summary="Use run-length encoding for compression" description="Use run-length encoding for compression" short="-U"
        flag "--rsyncable" summary="Input-determined block locations for rsync" description="Input-determined block locations for rsync" short="-R"
        flag "--stdout" summary="Write all processed output to stdout (won't delete)" description="Write all processed output to stdout (won't delete)" short="-c"
        flag "--suffix" summary="Use suffix .sss instead of .gz (for compression)" description="Use suffix .sss instead of .gz (for compression)" short="-S" value="value"
        flag "--synchronous" summary="Force output file write to permanent storage" description="Force output file write to permanent storage" short="-Y"
        flag "--test" summary="Test the integrity of the compressed input" description="Test the integrity of the compressed input" short="-t"
        flag "--time" summary="Store or restore mod time" description="Store or restore mod time" short="-M"
        flag "--verbose" summary="Provide more verbose output" description="Provide more verbose output" short="-v"
        flag "--version" summary="Show the version of pigz" description="Show the version of pigz" short="-V"
        flag "--zip" summary="Compress to PKWare zip (.zip) single entry format" description="Compress to PKWare zip (.zip) single entry format" short="-K"
        flag "--zlib" summary="Compress to zlib (.zz) instead of gzip format" description="Compress to zlib (.zz) instead of gzip format" short="-z"
        flag "-0" summary="Compression level 0" description="Compression level 0"
        flag "-1" summary="Compression level 1" description="Compression level 1"
        flag "-2" summary="Compression level 2" description="Compression level 2"
        flag "-3" summary="Compression level 3" description="Compression level 3"
        flag "-4" summary="Compression level 4" description="Compression level 4"
        flag "-5" summary="Compression level 5" description="Compression level 5"
        flag "-6" summary="Compression level 6" description="Compression level 6"
        flag "-7" summary="Compression level 7" description="Compression level 7"
        flag "-8" summary="Compression level 8" description="Compression level 8"
        flag "-9" summary="Compression level 9" description="Compression level 9"
    }
}

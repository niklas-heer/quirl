catalog "tinygo-draft" {
    provenance author="Carapace contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "tinygo" summary="TinyGo is a Go compiler for small places" description="TinyGo is a Go compiler for small places" {
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "--cpuprofile" summary="cpuprofile output" description="cpuprofile output" value="value"
        flag "--dumpssa" summary="dump internal Go SSA" description="dump internal Go SSA"
        flag "--gc" summary="garbage collector to use" description="garbage collector to use" value="value"
        flag "--ldflags" summary="Go link tool compatible ldflags" description="Go link tool compatible ldflags" value="value"
        flag "--llvm-features" summary="comma separated LLVM features to enable" description="comma separated LLVM features to enable" value="value"
        flag "--no-debug" summary="strip debug information" description="strip debug information"
        flag "--ocd-commands" summary="OpenOCD commands, overriding target spec" description="OpenOCD commands, overriding target spec" value="value"
        flag "--ocd-output" summary="print OCD daemon output during debug" description="print OCD daemon output during debug"
        flag "--opt" summary="optimization level" description="optimization level" value="value"
        flag "--panic" summary="panic strategy" description="panic strategy" value="value"
        flag "--port" summary="flash port" description="flash port" value="value"
        flag "--print-allocs" summary="regular expression of functions for which heap allocations should be printed" description="regular expression of functions for which heap allocations should be printed" value="value"
        flag "--print-stacks" summary="print stack sizes of goroutines" description="print stack sizes of goroutines"
        flag "--printir" summary="print LLVM IR" description="print LLVM IR"
        flag "--programmer" summary="which hardware programmer to use" description="which hardware programmer to use" value="value"
        flag "--scheduler" summary="which scheduler to use" description="which scheduler to use" value="value"
        flag "--serial" summary="which serial output to use" description="which serial output to use" value="value"
        flag "--size" summary="print sizes" description="print sizes" value="value"
        flag "--tags" summary="a space-separated list of extra build tags" description="a space-separated list of extra build tags" value="value"
        flag "--target" summary="chip/board name or JSON target specification file" description="chip/board name or JSON target specification file" value="value"
        flag "--verifyir" summary="run extra verification steps on LLVM IR" description="run extra verification steps on LLVM IR"
        flag "--wasm-abi" summary="WebAssembly ABI conventions" description="WebAssembly ABI conventions" value="value"
        flag "-o" summary="output" description="output" value="value" action="files"
        flag "-x" summary="Print commands" description="Print commands"
    }
}

catalog "jq-draft" {
    provenance author="Carapace contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "jq" summary="Command-line JSON processor" description="Command-line JSON processor" {
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "--arg" summary="pre-set a variable to a string" description="pre-set a variable to a string"
        flag "--argjson" summary="pre-set a variable to an object" description="pre-set a variable to an object"
        flag "--args" summary="remaining arguments are string arguments, not files" description="remaining arguments are string arguments, not files"
        flag "--ascii-output" summary="restrict output to ASCII" description="restrict output to ASCII" short="-a"
        flag "--binary" summary="force binary mode on Windows" description="force binary mode on Windows" short="-b"
        flag "--build-configuration" summary="output the build configuration of jq and exit" description="output the build configuration of jq and exit"
        flag "--color-output" summary="output in color" description="output in color" short="-C"
        flag "--compact-output" summary="don't pretty-print" description="don't pretty-print" short="-c"
        flag "--exit-status" summary="report \"false\" and \"null\" results via exit code" description="report \"false\" and \"null\" results via exit code" short="-e"
        flag "--from-file" summary="read filter from file" description="read filter from file" short="-f" value="value" action="files"
        flag "--indent" summary="indent output using given number of spaces" description="indent output using given number of spaces" value="value"
        flag "--join-output" summary="like -r, without newlines between outputs" description="like -r, without newlines between outputs" short="-j"
        flag "--jsonargs" summary="remaining arguments are JSON arguments, not files" description="remaining arguments are JSON arguments, not files"
        flag "--library-path" summary="prepend a directory to the module search path" description="prepend a directory to the module search path" value="value" action="directories"
        flag "--monochrome-output" summary="output without color" description="output without color" short="-M"
        flag "--null-input" summary="input is ignored" description="input is ignored" short="-n"
        flag "--raw-input" summary="consider each input line as a JSON strings" description="consider each input line as a JSON strings" short="-R"
        flag "--raw-output" summary="don't JSON-quote output if it's a string" description="don't JSON-quote output if it's a string" short="-r"
        flag "--raw-output0" summary="like -r but print NUL instead of newline after each output" description="like -r but print NUL instead of newline after each output"
        flag "--rawfile" summary="pre-set a variable to the contents of a file" description="pre-set a variable to the contents of a file"
        flag "--seq" summary="use application/json-seq ASCII RS/LF scheme in input and output" description="use application/json-seq ASCII RS/LF scheme in input and output"
        flag "--slurp" summary="join input JSON objects to array before filtering" description="join input JSON objects to array before filtering" short="-s"
        flag "--slurpfile" summary="pre-set a variable to an array of JSON texts read from a file" description="pre-set a variable to an array of JSON texts read from a file"
        flag "--sort-keys" summary="output object keys in sorted order" description="output object keys in sorted order" short="-S"
        flag "--stream" summary="parse input streamily (changes output)" description="parse input streamily (changes output)"
        flag "--stream-errors" summary="like --stream, but invalid JSON inputs yield array values" description="like --stream, but invalid JSON inputs yield array values"
        flag "--tab" summary="indent output using TAB characters" description="indent output using TAB characters"
        flag "--unbuffered" summary="flush output after each JSON object" description="flush output after each JSON object"
        flag "--version" summary="output jq's version number" description="output jq's version number"
        flag "-L" summary="prepend a directory to the module search path" description="prepend a directory to the module search path" value="value" action="directories"
    }
}

catalog "procs-draft" {
    provenance author="Carapace contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "procs" summary="a replacement for `ps` written in Rust" description="a replacement for `ps` written in Rust" {
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "--and" summary="AND  logic for multi-keyword" description="AND  logic for multi-keyword" short="-a"
        flag "--color" summary="Color mode" description="Color mode" short="-c" value="value"
        flag "--debug" summary="Show debug message" description="Show debug message"
        flag "--gen-completion" summary="Generate shell completion file" description="Generate shell completion file" value="value"
        flag "--gen-completion-out" summary="Generate shell completion file and write to stdout" description="Generate shell completion file and write to stdout" value="value"
        flag "--gen-config" summary="Generate configuration sample file" description="Generate configuration sample file"
        flag "--gen-man-page" summary="Generate man page and write to stdout" description="Generate man page and write to stdout"
        flag "--help" summary="Print help" description="Print help" short="-h"
        flag "--insert" summary="Insert column to slot" description="Insert column to slot" short="-i" value="value" repeatable=#true
        flag "--interval" summary="Interval to calculate throughput" description="Interval to calculate throughput" value="value"
        flag "--json" summary="JSON output" description="JSON output"
        flag "--list" summary="Show list of kind" description="Show list of kind" short="-l"
        flag "--load-config" summary="Load configuration from file" description="Load configuration from file" value="value" action="files"
        flag "--nand" summary="NAND logic for multi-keyword" description="NAND logic for multi-keyword" short="-d"
        flag "--no-header" summary="Suppress header" description="Suppress header"
        flag "--nor" summary="NOR  logic for multi-keyword" description="NOR  logic for multi-keyword" short="-r"
        flag "--only" summary="Specified column only" description="Specified column only" value="value"
        flag "--or" summary="OR   logic for multi-keyword" description="OR   logic for multi-keyword" short="-o"
        flag "--pager" summary="Pager mode" description="Pager mode" short="-p" value="value"
        flag "--procfs" summary="Path to procfs" description="Path to procfs"
        flag "--regex" summary="Use regex search mode (single PATTERN)" description="Use regex search mode (single PATTERN)"
        flag "--smart" summary="Use smart mode (auto-detect regex syntax)" description="Use smart mode (auto-detect regex syntax)"
        flag "--sorta" summary="Sort column by ascending" description="Sort column by ascending" value="value"
        flag "--sortd" summary="Sort column by descending" description="Sort column by descending" value="value"
        flag "--text" summary="Use plain text search mode (default)" description="Use plain text search mode (default)"
        flag "--theme" summary="Theme mode" description="Theme mode" value="value"
        flag "--thread" summary="Show thread" description="Show thread"
        flag "--tree" summary="Tree view" description="Tree view" short="-t"
        flag "--use-config" summary="Use built-in configuration" description="Use built-in configuration" value="value"
        flag "--version" summary="Print version" description="Print version" short="-V"
        flag "--watch" summary="Watch mode with default interval (1s)" description="Watch mode with default interval (1s)" short="-w"
        flag "--watch-interval" summary="Watch mode with custom interval" description="Watch mode with custom interval" short="-W" value="value"
    }
}

catalog "ssh-draft" {
    provenance author="Carapace contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "ssh" summary="OpenSSH remote login client" description="OpenSSH remote login client" {
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "-4" summary="Forces ssh to use IPv4 addresses only" description="Forces ssh to use IPv4 addresses only"
        flag "-6" summary="Forces ssh to use IPv6 addresses only" description="Forces ssh to use IPv6 addresses only"
        flag "-A" summary="Enables forwarding of connections from an authentication agent" description="Enables forwarding of connections from an authentication agent"
        flag "-B" summary="Bind to given address before attempting to connect" description="Bind to given address before attempting to connect" value="value"
        flag "-C" summary="Requests compression of all data" description="Requests compression of all data"
        flag "-D" summary="Specifies a local “dynamic” application-level port forwarding" description="Specifies a local “dynamic” application-level port forwarding" value="value"
        flag "-E" summary="Append debug logs to log_file instead of standard error" description="Append debug logs to log_file instead of standard error" value="value" action="files"
        flag "-F" summary="Specifies an alternative per-user configuration file" description="Specifies an alternative per-user configuration file" value="value" action="files"
        flag "-G" summary="Causes ssh to print its configuration after evaluating Host and Match blocks and exit" description="Causes ssh to print its configuration after evaluating Host and Match blocks and exit"
        flag "-I" summary="Specify the PKCS#11 shared library ssh should use" description="Specify the PKCS#11 shared library ssh should use" value="value" action="files"
        flag "-J" summary="Connect to the target host by using given jump host" description="Connect to the target host by using given jump host" value="value"
        flag "-K" summary="Enables GSSAPI-based authentication and forwarding of GSSAPI credentials" description="Enables GSSAPI-based authentication and forwarding of GSSAPI credentials"
        flag "-L" summary="Specifies that connections are to be forwarded" description="Specifies that connections are to be forwarded" value="value"
        flag "-M" summary="Places the ssh client into “master” mode for connection sharing" description="Places the ssh client into “master” mode for connection sharing"
        flag "-N" summary="Do not execute a remote command.  This is useful for just forwarding ports." description="Do not execute a remote command.  This is useful for just forwarding ports."
        flag "-O" summary="Control an active connection multiplexing master process" description="Control an active connection multiplexing master process" value="value"
        flag "-Q" summary="Queries ssh for the algorithms supported" description="Queries ssh for the algorithms supported" value="value"
        flag "-R" summary="Specifies that connections ar to be forwarded" description="Specifies that connections ar to be forwarded" value="value"
        flag "-S" summary="Specifies the location of a control socket" description="Specifies the location of a control socket" value="value" action="files"
        flag "-T" summary="Disable pseudo-terminal allocation" description="Disable pseudo-terminal allocation"
        flag "-V" summary="Display the version number and exit" description="Display the version number and exit"
        flag "-W" summary="Requests that standard input and output on the client be forwarded" description="Requests that standard input and output on the client be forwarded" value="value"
        flag "-X" summary="Enables X11 forwarding" description="Enables X11 forwarding"
        flag "-Y" summary="Enables trusted X11 forwarding" description="Enables trusted X11 forwarding"
        flag "-a" summary="Disables forwarding of the authentication agent connection." description="Disables forwarding of the authentication agent connection."
        flag "-b" summary="Use bind_address on the local machine as the source address of the connection" description="Use bind_address on the local machine as the source address of the connection" value="value"
        flag "-c" summary="Selects the cipher specification for encrypting the session" description="Selects the cipher specification for encrypting the session" value="value"
        flag "-e" summary="Sets the escape character for sessions with a pty" description="Sets the escape character for sessions with a pty" value="value"
        flag "-f" summary="Requests ssh to go to background just before command execution" description="Requests ssh to go to background just before command execution"
        flag "-g" summary="Allows remote hosts to connect to local forwarded ports" description="Allows remote hosts to connect to local forwarded ports"
        flag "-i" summary="Selects a file from which the identity (private key) is read" description="Selects a file from which the identity (private key) is read" value="value"
        flag "-k" summary="Disables forwarding of GSSAPI credentials to the server" description="Disables forwarding of GSSAPI credentials to the server"
        flag "-l" summary="Specifies the user to log in as on the remote machine" description="Specifies the user to log in as on the remote machine" value="value"
        flag "-m" summary="A comma-separated list of MAC algorithms" description="A comma-separated list of MAC algorithms" value="value"
        flag "-n" summary="Redirects stdin from /dev/null" description="Redirects stdin from /dev/null"
        flag "-o" summary="Can be used to give options in the format used in the configuration file" description="Can be used to give options in the format used in the configuration file" value="value"
        flag "-p" summary="Port to connect to on the remote host" description="Port to connect to on the remote host" value="value"
        flag "-q" summary="Quiet mode" description="Quiet mode"
        flag "-s" summary="May be used to request invocation of a subsystem on the remote system" description="May be used to request invocation of a subsystem on the remote system"
        flag "-t" summary="Force pseudo-terminal allocation" description="Force pseudo-terminal allocation"
        flag "-v" summary="Verbose mode" description="Verbose mode"
        flag "-w" summary="Requests tunnel device forwarding" description="Requests tunnel device forwarding" value="value"
        flag "-x" summary="Disables X11 forwarding" description="Disables X11 forwarding"
        flag "-y" summary="Send log information using the syslog system module" description="Send log information using the syslog system module"
    }
}

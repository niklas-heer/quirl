catalog "gdb-draft" {
    provenance author="Carapace contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "gdb" summary="This is the GNU debugger" description="This is the GNU debugger" {
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "--args" summary="Arguments after executable-file are passed to inferior." description="Arguments after executable-file are passed to inferior."
        flag "--batch" summary="Exit after processing options." description="Exit after processing options."
        flag "--batch-silent" summary="Like --batch, but suppress all gdb stdout output." description="Like --batch, but suppress all gdb stdout output."
        flag "--cd" summary="Change current directory to DIR." description="Change current directory to DIR." value="value" action="directories"
        flag "--command" summary="Execute GDB commands from FILE." description="Execute GDB commands from FILE." short="-x" value="value" action="files"
        flag "--configuration" summary="Print details about GDB configuration and then exit." description="Print details about GDB configuration and then exit."
        flag "--core" summary="Analyze the core dump COREFILE." description="Analyze the core dump COREFILE." value="value" action="files"
        flag "--data-directory" summary="Set GDB's data-directory to DIR." description="Set GDB's data-directory to DIR." short="-D" value="value" action="directories"
        flag "--dbx" summary="DBX compatibility mode." description="DBX compatibility mode."
        flag "--directory" summary="Search for source files in DIR." description="Search for source files in DIR." value="value" action="directories"
        flag "--eval-command" summary="Execute a single GDB command." description="Execute a single GDB command." value="value"
        flag "--exec" summary="Use EXECFILE as the executable." description="Use EXECFILE as the executable." value="value" action="files"
        flag "--fullname" summary="Output information used by emacs-GDB interface." description="Output information used by emacs-GDB interface."
        flag "--help" summary="Print this message and then exit." description="Print this message and then exit."
        flag "--init-command" summary="Like -x but execute commands before loading inferior." description="Like -x but execute commands before loading inferior." value="value"
        flag "--init-eval-command" summary="Like -ex but before loading inferior." description="Like -ex but before loading inferior." value="value"
        flag "--interpreter" summary="Select a specific interpreter / user interface." description="Select a specific interpreter / user interface." value="value"
        flag "--nh" summary="Do not read ~/.gdbinit." description="Do not read ~/.gdbinit."
        flag "--nw" summary="Do not use the GUI interface." description="Do not use the GUI interface."
        flag "--nx" summary="Do not read any .gdbinit files in any directory." description="Do not read any .gdbinit files in any directory."
        flag "--pid" summary="Attach to running process PID." description="Attach to running process PID." value="value"
        flag "--quiet" summary="Do not print version number on startup." description="Do not print version number on startup." short="-q"
        flag "--readnever" summary="Do not read symbol files." description="Do not read symbol files."
        flag "--readnow" summary="Fully read symbol files on first access." description="Fully read symbol files on first access."
        flag "--return-child-result" summary="GDB exit code will be the child's exit code." description="GDB exit code will be the child's exit code."
        flag "--se" summary="Use FILE as symbol file and executable file." description="Use FILE as symbol file and executable file." value="value" action="files"
        flag "--silent" summary="Do not print version number on startup." description="Do not print version number on startup."
        flag "--symbols" summary="Read symbols from SYMFILE." description="Read symbols from SYMFILE." value="value" action="files"
        flag "--tty" summary="Use TTY for input/output by the program being debugged." description="Use TTY for input/output by the program being debugged." value="value"
        flag "--tui" summary="Use a terminal user interface." description="Use a terminal user interface."
        flag "--version" summary="Print version information and then exit." description="Print version information and then exit."
        flag "--write" summary="Set writing into executable and core files." description="Set writing into executable and core files."
        flag "-b" summary="Set serial port baud rate used for remote debugging." description="Set serial port baud rate used for remote debugging." value="value"
        flag "-l" summary="Set timeout in seconds for remote debugging." description="Set timeout in seconds for remote debugging." value="value"
        flag "-w" summary="Use the GUI interface." description="Use the GUI interface."
    }
}

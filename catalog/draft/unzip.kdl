catalog "unzip-draft" {
    provenance author="Carapace contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "unzip" summary="list, test and extract compressed files in a ZIP archive" description="list, test and extract compressed files in a ZIP archive" {
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "--aa" summary="treat ALL files as text" description="treat ALL files as text"
        flag "-C" summary="match filenames case-insensitively" description="match filenames case-insensitively"
        flag "-I" summary="specify a character encoding for UNIX and other archives" description="specify a character encoding for UNIX and other archives" value="value"
        flag "-K" summary="keep setuid/setgid/tacky permissions" description="keep setuid/setgid/tacky permissions"
        flag "-L" summary="make (some) names lowercase" description="make (some) names lowercase"
        flag "-M" summary="pipe through \"more\" pager" description="pipe through \"more\" pager"
        flag "-O" summary="specify a character encoding for DOS, Windows and OS/2 archives" description="specify a character encoding for DOS, Windows and OS/2 archives" value="value"
        flag "-T" summary="timestamp archive to latest" description="timestamp archive to latest"
        flag "-U" summary="use escapes for all non-ASCII Unicode" description="use escapes for all non-ASCII Unicode"
        flag "-V" summary="retain VMS version numbers" description="retain VMS version numbers"
        flag "-X" summary="restore UID/GID info" description="restore UID/GID info"
        flag "-Z" summary="ZipInfo mode" description="ZipInfo mode"
        flag "-a" summary="auto-convert any text files" description="auto-convert any text files"
        flag "-d" summary="extract files into exdir" description="extract files into exdir" value="value" action="directories"
        flag "-f" summary="freshen existing files, create none" description="freshen existing files, create none"
        flag "-j" summary="junk paths (do not make directories)" description="junk paths (do not make directories)"
        flag "-l" summary="list files (short format)" description="list files (short format)"
        flag "-n" summary="never overwrite existing files" description="never overwrite existing files"
        flag "-o" summary="overwrite files WITHOUT prompting" description="overwrite files WITHOUT prompting"
        flag "-p" summary="extract files to pipe, no messages" description="extract files to pipe, no messages"
        flag "-q" summary="quiet mode (-qq => quieter)" description="quiet mode (-qq => quieter)"
        flag "-t" summary="test compressed archive data" description="test compressed archive data"
        flag "-u" summary="update files, create if necessary" description="update files, create if necessary"
        flag "-v" summary="list verbosely/show version info" description="list verbosely/show version info"
        flag "-x" summary="exclude files that follow (in xlist)" description="exclude files that follow (in xlist)" value="value"
        flag "-z" summary="display archive comment only" description="display archive comment only"
    }
}

catalog "man-draft" {
    provenance author="Carapace contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "man" summary="an interface to the system reference manuals" description="an interface to the system reference manuals" {
        platform "linux"
        platform "macos"
        platform "freebsd"
        flag "--all" summary="find all matching manual pages" description="find all matching manual pages" short="-a"
        flag "--apropos" summary="equivalent to apropos" description="equivalent to apropos" short="-k"
        flag "--ascii" summary="display ASCII translation of certain latin1 chars" description="display ASCII translation of certain latin1 chars" short="-7"
        flag "--catman" summary="used by catman to reformat out of date cat pages" description="used by catman to reformat out of date cat pages" short="-c"
        flag "--config-file" summary="use this user configuration file" description="use this user configuration file" short="-C" value="value" action="files"
        flag "--debug" summary="emit debugging messages" description="emit debugging messages" short="-d"
        flag "--default" summary="reset all options to their default values" description="reset all options to their default values" short="-D"
        flag "--ditroff" summary="use groff and force it to produce ditroff" description="use groff and force it to produce ditroff" short="-Z"
        flag "--encoding" summary="use selected output encoding" description="use selected output encoding" short="-E" value="value"
        flag "--extension" summary="limit search to extension type EXTENSION" description="limit search to extension type EXTENSION" short="-e" value="value"
        flag "--global-apropos" summary="search for text in all pages" description="search for text in all pages" short="-K"
        flag "--gxditview" summary="use groff and display through gxditview" description="use groff and display through gxditview" short="-X" value="value"
        flag "--help" summary="give this help list" description="give this help list"
        flag "--html" summary="use  or BROWSER to display HTML output" description="use  or BROWSER to display HTML output" short="-H" value="value"
        flag "--ignore-case" summary="look for pages case-insensitively (default)" description="look for pages case-insensitively (default)" short="-i"
        flag "--local-file" summary="interpret PAGE argument(s) as local filename(s)" description="interpret PAGE argument(s) as local filename(s)" short="-l"
        flag "--locale" summary="define the locale for this particular man search" description="define the locale for this particular man search" short="-L" value="value"
        flag "--location" summary="print physical location of man page(s)" description="print physical location of man page(s)"
        flag "--location-cat" summary="print physical location of cat file(s)" description="print physical location of cat file(s)"
        flag "--manpath" summary="set search path for manual pages to PATH" description="set search path for manual pages to PATH" short="-M" value="value" action="directories"
        flag "--match-case" summary="look for pages case-sensitively" description="look for pages case-sensitively" short="-I"
        flag "--names-only" summary="make --regex and --wildcard match page names only," description="make --regex and --wildcard match page names only,"
        flag "--nh" summary="turn off hyphenation" description="turn off hyphenation"
        flag "--nj" summary="turn off justification" description="turn off justification"
        flag "--no-hyphenation" summary="turn off hyphenation" description="turn off hyphenation"
        flag "--no-justification" summary="turn off justification" description="turn off justification"
        flag "--no-subpages" summary="don't try subpages, e.g. 'man foo bar' => 'man" description="don't try subpages, e.g. 'man foo bar' => 'man"
        flag "--pager" summary="use program PAGER to display output" description="use program PAGER to display output" short="-P" value="value" action="files"
        flag "--path" summary="print physical location of man page(s)" description="print physical location of man page(s)"
        flag "--preprocessor" summary="STRING indicates which preprocessors to run" description="STRING indicates which preprocessors to run" short="-p" value="value"
        flag "--prompt" summary="provide the `less' pager with a prompt" description="provide the `less' pager with a prompt" short="-r" value="value"
        flag "--recode" summary="output source page encoded in ENCODING" description="output source page encoded in ENCODING" short="-R" value="value"
        flag "--regex" summary="show all pages matching regex" description="show all pages matching regex"
        flag "--sections" summary="use colon separated section list" description="use colon separated section list" short="-s" value="value"
        flag "--systems" summary="use manual pages from other systems" description="use manual pages from other systems" short="-m" value="value"
        flag "--troff" summary="use groff to format pages" description="use groff to format pages" short="-t"
        flag "--troff-device" summary="use groff with selected device" description="use groff with selected device" short="-T" value="value"
        flag "--update" summary="force a cache consistency check" description="force a cache consistency check" short="-u"
        flag "--usage" summary="give a short usage message" description="give a short usage message"
        flag "--version" summary="print program version" description="print program version" short="-V"
        flag "--warnings" summary="enable warnings from groff" description="enable warnings from groff" value="value"
        flag "--whatis" summary="equivalent to whatis" description="equivalent to whatis" short="-f"
        flag "--where" summary="print physical location of man page(s)" description="print physical location of man page(s)" short="-w"
        flag "--where-cat" summary="print physical location of cat file(s)" description="print physical location of cat file(s)" short="-W"
        flag "--wildcard" summary="show all pages matching wildcard" description="show all pages matching wildcard"
        flag "-S" summary="use colon separated section list" description="use colon separated section list"
    }
}

catalog "lua-draft" {
    provenance author="Carapace contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "lua" summary="Lua interpreter" description="Lua interpreter" {
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "-E" summary="ignore environment variables" description="ignore environment variables"
        flag "-W" summary="turn warnings on" description="turn warnings on"
        flag "-e" summary="execute string 'stat'" description="execute string 'stat'" value="value"
        flag "-i" summary="enter interactive mode after executing 'script'" description="enter interactive mode after executing 'script'"
        flag "-l" summary="require library 'name' into global 'name'" description="require library 'name' into global 'name'" value="value"
        flag "-v" summary="show version information" description="show version information"
    }
}

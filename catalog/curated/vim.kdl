catalog "vim" {
    provenance author="Carapace contributors; curated by Quirl contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "vim" summary="Edit text with Vim" description="Opens files and commands in the interactive Vim terminal editor." {
        alias "vi"
        intent "edit a text file"
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "--clean" summary="'nocompatible', Vim defaults, no plugins, no viminfo" description="'nocompatible', Vim defaults, no plugins, no viminfo"
        flag "--cmd" summary="Execute <command> before loading any vimrc file" description="Execute <command> before loading any vimrc file" value="value"
        flag "--help" summary="Print Help (this message) and exit" description="Print Help (this message) and exit" short="-h"
        flag "--log" summary="Start logging to <file> early" description="Start logging to <file> early" value="value" action="files"
        flag "--noplugin" summary="Do not load plugin scripts" description="Do not load plugin scripts"
        flag "--not-a-term" summary="Skip warning for input/output not being a terminal" description="Skip warning for input/output not being a terminal"
        flag "--remote" summary="Edit <files> in a Vim server if possible" description="Edit <files> in a Vim server if possible" value="value" action="files"
        flag "--remote-expr" summary="Evaluate <expr> in a Vim server and print result" description="Evaluate <expr> in a Vim server and print result" value="value"
        flag "--remote-send" summary="Send <keys> to a Vim server and exit" description="Send <keys> to a Vim server and exit" value="value"
        flag "--remote-silent" summary="Same as --remote, do not complain if there is no server" description="Same as --remote, do not complain if there is no server"
        flag "--remote-tab" summary="As --remote but use tab page per file" description="As --remote but use tab page per file" value="value" action="files"
        flag "--remote-tab-silent" summary="As --remote-silent but use tab page per file" description="As --remote-silent but use tab page per file" value="value" action="files"
        flag "--remote-tab-wait" summary="As --remote-wait but use tab page per file" description="As --remote-wait but use tab page per file" value="value" action="files"
        flag "--remote-tab-wait-silent" summary="As --remote-wait-silent but use tab page per file" description="As --remote-wait-silent but use tab page per file" value="value" action="files"
        flag "--remote-wait" summary="As --remote but wait for files to have been edited" description="As --remote but wait for files to have been edited" value="value" action="files"
        flag "--remote-wait-silent" summary="Same as --remote-wait, do not complain if there is no server" description="Same as --remote-wait, do not complain if there is no server" value="value" action="files"
        flag "--serverlist" summary="List available Vim server names and exit" description="List available Vim server names and exit"
        flag "--servername" summary="Send to/become the Vim server <name>" description="Send to/become the Vim server <name>" value="value"
        flag "--startuptime" summary="Write startup timing messages to <file>" description="Write startup timing messages to <file>" value="value" action="files"
        flag "--ttyfail" summary="Exit if input or output is not a terminal" description="Exit if input or output is not a terminal"
        flag "--version" summary="Print version information and exit" description="Print version information and exit"
        flag "-A" summary="Start in Arabic mode" description="Start in Arabic mode"
        flag "-C" summary="Compatible with Vi: 'compatible'" description="Compatible with Vi: 'compatible'"
        flag "-D" summary="Debugging mode" description="Debugging mode"
        flag "-E" summary="Improved Ex mode" description="Improved Ex mode"
        flag "-H" summary="Start in Hebrew mode" description="Start in Hebrew mode"
        flag "-L" summary="Same as -r" description="Same as -r"
        flag "-M" summary="Modifications in text not allowed" description="Modifications in text not allowed"
        flag "-N" summary="Not fully Vi compatible: 'nocompatible'" description="Not fully Vi compatible: 'nocompatible'"
        flag "-O" summary="Like -o but split vertically" description="Like -o but split vertically" value="value"
        flag "-R" summary="Readonly mode" description="Readonly mode"
        flag "-S" summary="Source file <session> after loading the first file" description="Source file <session> after loading the first file" value="value" action="files"
        flag "-T" summary="Set terminal type to <terminal>" description="Set terminal type to <terminal>" value="value"
        flag "-V" summary="Be verbose" description="Be verbose" value="value"
        flag "-W" summary="Write all typed commands to file <scriptout>" description="Write all typed commands to file <scriptout>" value="value" action="files"
        flag "-Z" summary="Restricted mode" description="Restricted mode"
        flag "-b" summary="Binary mode" description="Binary mode"
        flag "-c" summary="Execute <command> after loading the first file" description="Execute <command> after loading the first file" value="value"
        flag "-d" summary="Diff mode" description="Diff mode"
        flag "-e" summary="Ex mode" description="Ex mode"
        flag "-i" summary="Use <viminfo> instead of .viminfo" description="Use <viminfo> instead of .viminfo" value="value" action="files"
        flag "-l" summary="Lisp mode" description="Lisp mode"
        flag "-m" summary="Modifications (writing files) not allowed" description="Modifications (writing files) not allowed"
        flag "-n" summary="No swap file, use memory only" description="No swap file, use memory only"
        flag "-o" summary="Open N windows" description="Open N windows" value="value"
        flag "-p" summary="Open N tab pages" description="Open N tab pages" value="value"
        flag "-r" summary="List swap files or recover crashed session" description="List swap files or recover crashed session"
        flag "-s" summary="Read Normal mode commands from file <scriptin>" description="Read Normal mode commands from file <scriptin>" value="value" action="files"
        flag "-u" summary="Use <vimrc> instead of any .vimrc" description="Use <vimrc> instead of any .vimrc" value="value" action="files"
        flag "-v" summary="Vi mode" description="Vi mode"
        flag "-w" summary="Append all typed commands to file <scriptout>" description="Append all typed commands to file <scriptout>" value="value" action="files"
        flag "-x" summary="Edit encrypted files" description="Edit encrypted files"
        flag "-y" summary="Easy mode" description="Easy mode"
        argument "files" summary="Files to edit" description="Files to open in editor buffers." repeatable=#true action="files"
    }
}

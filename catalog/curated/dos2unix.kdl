catalog "dos2unix" {
    provenance author="Carapace contributors; curated by Quirl contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "dos2unix" summary="Convert text files to Unix line endings" description="Converts DOS or classic Mac text-file line endings to Unix format." {
        intent "convert line endings to unix"
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "--add-bom" summary="add Byte Order Mark (default UTF-8)" description="add Byte Order Mark (default UTF-8)" short="-m"
        flag "--allow-chown" summary="allow file ownership change" description="allow file ownership change"
        flag "--convmode" summary="conversion mode" description="conversion mode" short="-c" value="value"
        flag "--display-enc" summary="Set encoding of displayed text." description="Set encoding of displayed text." short="-D" value="value"
        flag "--follow-symlink" summary="follow symbolic links and convert the targets" description="follow symbolic links and convert the targets" short="-F"
        flag "--force" summary="force conversion of binary files" description="force conversion of binary files" short="-f"
        flag "--help" summary="display this help text" description="display this help text" short="-h"
        flag "--info" summary="display file information" description="display file information" short="-i" value="value"
        flag "--keep-bom" summary="keep Byte Order Mark" description="keep Byte Order Mark" short="-b"
        flag "--keep-utf16" summary="keep UTF-16 encoding" description="keep UTF-16 encoding" short="-u"
        flag "--keepdate" summary="keep output file date" description="keep output file date" short="-k"
        flag "--license" summary="display software license" description="display software license" short="-L"
        flag "--newfile" summary="write to new file" description="write to new file" short="-n"
        flag "--newline" summary="add additional newline" description="add additional newline" short="-l"
        flag "--no-allow-chown" summary="don't allow file ownership change (default)" description="don't allow file ownership change (default)"
        flag "--oldfile" summary="write to old file (default)" description="write to old file (default)" short="-o"
        flag "--quiet" summary="quiet mode, suppress all warnings" description="quiet mode, suppress all warnings" short="-q"
        flag "--remove-bom" summary="remove Byte Order Mark (default)" description="remove Byte Order Mark (default)" short="-r"
        flag "--safe" summary="skip binary files (default)" description="skip binary files (default)" short="-s"
        flag "--skip-symlink" summary="keep symbolic links and targets unchanged (default)" description="keep symbolic links and targets unchanged (default)" short="-S"
        flag "--verbose" summary="verbose operation" description="verbose operation" short="-v"
        flag "--version" summary="display version number" description="display version number" short="-V"
        flag "-7" summary="convert 8 bit characters to 7 bit space" description="convert 8 bit characters to 7 bit space"
        argument "files" summary="Text files" description="Files whose line endings are converted." required=#true repeatable=#true action="files"
    }
}

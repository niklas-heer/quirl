catalog "diff" {
    provenance author="Carapace contributors; curated by Quirl contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "diff" summary="Compare files line by line" description="Compares files or directories and reports the changes needed to make them match." {
        intent "compare directories"
        intent "compare two files"
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "--brief" summary="report only when files differ" description="report only when files differ" short="-q" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--changed-group-format" summary="set changed group format" description="set changed group format" value="value" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--color" summary="colorize the output" description="colorize the output" value="value" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--context" summary="output NUM (default 3) lines of copied context" description="output NUM (default 3) lines of copied context" short="-c" value="value" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--ed" summary="output an ed script" description="output an ed script" short="-e" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--exclude" summary="exclude files that match PAT" description="exclude files that match PAT" short="-x" value="value" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--exclude-from" summary="exclude files that match any pattern in FILE" description="exclude files that match any pattern in FILE" short="-X" value="value" action="files" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--expand-tabs" summary="expand tabs to spaces in output" description="expand tabs to spaces in output" short="-t" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--expand-tabs" summary="Expand tabs in output" description="Expand tab characters to spaces in generated output." short="-t" {
            platform "macos"
        }
        flag "--forward-ed" summary="output a reversed ed script" description="output a reversed ed script" short="-f" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--from-file" summary="compare FILE1 to all operands" description="compare FILE1 to all operands" value="value" action="files" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--help" summary="display this help and exit" description="display this help and exit" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--help" summary="Show help" description="Display diff usage information and exit." {
            platform "macos"
        }
        flag "--horizon-lines" summary="keep NUM lines of the common prefix and suffix" description="keep NUM lines of the common prefix and suffix" value="value" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--ifdef" summary="output merged file with '#ifdef NAME' diffs" description="output merged file with '#ifdef NAME' diffs" short="-D" value="value" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--ignore-all-space" summary="ignore all white space" description="ignore all white space" short="-w" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--ignore-blank-lines" summary="ignore changes where lines are all blank" description="ignore changes where lines are all blank" short="-B" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--ignore-blank-lines" summary="Ignore blank-line changes" description="Ignore changes whose affected lines are all blank." short="-B" {
            platform "macos"
        }
        flag "--ignore-case" summary="ignore case differences in file contents" description="ignore case differences in file contents" short="-i" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--ignore-case" summary="Ignore letter case" description="Compare file contents without distinguishing letter case." short="-i" {
            platform "macos"
        }
        flag "--ignore-file-name-case" summary="ignore case when comparing file names" description="ignore case when comparing file names" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--ignore-matching-lines" summary="ignore changes where all lines match RE" description="ignore changes where all lines match RE" short="-I" value="value" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--ignore-space-change" summary="ignore changes in the amount of white space" description="ignore changes in the amount of white space" short="-b" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--ignore-tab-expansion" summary="ignore changes due to tab expansion" description="ignore changes due to tab expansion" short="-E" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--ignore-trailing-space" summary="ignore white space at line end" description="ignore white space at line end" short="-Z" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--initial-tab" summary="make tabs line up by prepending a tab" description="make tabs line up by prepending a tab" short="-T" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--label" summary="use LABEL instead of file name and timestamp" description="use LABEL instead of file name and timestamp" short="-L" value="value" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--left-column" summary="output only the left column of common lines" description="output only the left column of common lines" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--line-format" summary="format all input lines with LFMT" description="format all input lines with LFMT" value="value" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--minimal" summary="try hard to find a smaller set of changes" description="try hard to find a smaller set of changes" short="-d" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--minimal" summary="Find a smaller change set" description="Spend additional work to find a smaller set of differences." short="-d" {
            platform "macos"
        }
        flag "--new-file" summary="treat absent files as empty" description="treat absent files as empty" short="-N" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--new-group-format" summary="set new group format" description="set new group format" value="value" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--new-line-format" summary="set new line format" description="set new line format" value="value" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--no-dereference" summary="don't follow symbolic links" description="don't follow symbolic links" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--no-ignore-case" summary="Compare content case" description="Keep content comparisons case-sensitive." {
            platform "macos"
        }
        flag "--no-ignore-file-name-case" summary="consider case when comparing file names" description="consider case when comparing file names" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--no-ignore-file-name-case" summary="Compare file-name case" description="Keep file-name comparisons case-sensitive." {
            platform "macos"
        }
        flag "--normal" summary="output a normal diff (the default)" description="output a normal diff (the default)" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--normal" summary="Use normal diff output" description="Produce the default normal difference format." {
            platform "macos"
        }
        flag "--old-group-format" summary="set old group format" description="set old group format" value="value" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--old-line-format" summary="set old line format" description="set old line format" value="value" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--paginate" summary="pass output through 'pr' to paginate it" description="pass output through 'pr' to paginate it" short="-l" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--palette" summary="the colors to use when --color is active" description="the colors to use when --color is active" value="value" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--rcs" summary="output an RCS format diff" description="output an RCS format diff" short="-n" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--recursive" summary="recursively compare any subdirectories found" description="recursively compare any subdirectories found" short="-r" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--report-identical-files" summary="report when two files are the same" description="report when two files are the same" short="-s" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--show-c-function" summary="show which C function each change is in" description="show which C function each change is in" short="-p" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--show-function-line" summary="show the most recent line matching RE" description="show the most recent line matching RE" short="-F" value="value" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--side-by-side" summary="output in two columns" description="output in two columns" short="-y" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--side-by-side" summary="Use side-by-side output" description="Display corresponding file lines in two columns." short="-y" {
            platform "macos"
        }
        flag "--speed-large-files" summary="assume large files and many scattered small changes" description="assume large files and many scattered small changes" short="-H" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--starting-file" summary="start with FILE when comparing directories" description="start with FILE when comparing directories" short="-S" value="value" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--strip-trailing-cr" summary="strip trailing carriage return on input" description="strip trailing carriage return on input" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--strip-trailing-cr" summary="Strip trailing carriage returns" description="Ignore carriage returns at the end of input lines." {
            platform "macos"
        }
        flag "--suppress-blank-empty" summary="suppress space or tab before empty output lines" description="suppress space or tab before empty output lines" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--suppress-common-lines" summary="do not output common lines" description="do not output common lines" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--suppress-common-lines" summary="Hide common side-by-side lines" description="Omit identical lines from side-by-side output." {
            platform "macos"
        }
        flag "--tabsize" summary="tab stops every NUM (default 8) print columns" description="tab stops every NUM (default 8) print columns" value="value" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--tabsize" summary="Select tab width" description="Use the supplied number of print columns for each tab stop." value="columns" {
            platform "macos"
        }
        flag "--text" summary="treat all files as text" description="treat all files as text" short="-a" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--text" summary="Treat all files as text" description="Compare binary-looking inputs as text files." short="-a" {
            platform "macos"
        }
        flag "--to-file" summary="compare all operands to FILE2" description="compare all operands to FILE2" value="value" action="files" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--unchanged-group-format" summary="set unchanged group format" description="set unchanged group format" value="value" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--unchanged-line-format" summary="set unchanged line format" description="set unchanged line format" value="value" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--unidirectional-new-file" summary="treat absent first files as empty" description="treat absent first files as empty" short="-P" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--unified" summary="output NUM (default 3) lines of unified context" description="output NUM (default 3) lines of unified context" short="-u" value="value" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--version" summary="output version information and exit" description="output version information and exit" short="-v" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--version" summary="Show version information" description="Display diff version information and exit." {
            platform "macos"
        }
        flag "--width" summary="output at most NUM (default 130) print columns" description="output at most NUM (default 130) print columns" short="-W" value="value" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "--width" summary="Set side-by-side width" description="Limit side-by-side output to the supplied number of columns." short="-W" value="columns" {
            platform "macos"
        }
        flag "-C" summary="output NUM (default 3) lines of copied context" description="output NUM (default 3) lines of copied context" value="value" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "-C" summary="Set context size" description="Produce a context diff with the supplied number of surrounding lines." value="lines" {
            platform "macos"
        }
        flag "-D" summary="Merge with preprocessor conditionals" description="Create merged output guarded by the supplied preprocessor symbol." value="symbol" {
            platform "macos"
        }
        flag "-F" summary="Show matching function lines" description="Show the most recent line matching the supplied expression around each change." value="pattern" {
            platform "macos"
        }
        flag "-I" summary="Ignore matching changed lines" description="Ignore changes whose lines all match the supplied expression." value="pattern" {
            platform "macos"
        }
        flag "-L" summary="Set an output label" description="Use the supplied label instead of a file name and timestamp." value="label" repeatable=#true {
            platform "macos"
        }
        flag "-N" summary="Treat missing files as empty" description="Compare absent files as though they were empty." {
            platform "macos"
        }
        flag "-P" summary="Treat a missing first file as empty" description="When comparing directories, treat an absent first-side file as empty." {
            platform "macos"
        }
        flag "-S" summary="Start directory comparison at a name" description="Begin directory comparison with the supplied file name." value="name" {
            platform "macos"
        }
        flag "-U" summary="output NUM (default 3) lines of unified context" description="output NUM (default 3) lines of unified context" value="value" {
            platform "linux"
            platform "windows"
            platform "freebsd"
        }
        flag "-U" summary="Set unified context size" description="Produce a unified diff with the supplied number of surrounding lines." value="lines" {
            platform "macos"
        }
        flag "-X" summary="Read exclusion patterns" description="Exclude names matching patterns read from the supplied file." value="file" action="files" {
            platform "macos"
        }
        flag "-b" summary="Ignore whitespace amount" description="Ignore changes in the amount of whitespace." {
            platform "macos"
        }
        flag "-c" summary="Use context output" description="Produce a context-format difference listing." {
            platform "macos"
        }
        flag "-e" summary="Produce an ed script" description="Write an ed script that converts the first file into the second." {
            platform "macos"
        }
        flag "-f" summary="Produce a forward ed script" description="Write an ed script in forward order." {
            platform "macos"
        }
        flag "-l" summary="Paginate output" description="Pass difference output through pr for pagination." {
            platform "macos"
        }
        flag "-n" summary="Use RCS output" description="Produce an RCS-format difference listing." {
            platform "macos"
        }
        flag "-p" summary="Show C function names" description="Show the C function containing each change." {
            platform "macos"
        }
        flag "-q" summary="Report only whether files differ" description="Suppress difference details and report only differing files." {
            platform "macos"
        }
        flag "-r" summary="Compare directories recursively" description="Recursively compare subdirectories that occur on both sides." {
            platform "macos"
        }
        flag "-s" summary="Report identical files" description="Print a message when compared files are identical." {
            platform "macos"
        }
        flag "-u" summary="Use unified output" description="Produce a unified-format difference listing." {
            platform "macos"
        }
        flag "-w" summary="Ignore all whitespace" description="Ignore whitespace while comparing file contents." {
            platform "macos"
        }
        flag "-x" summary="Exclude matching names" description="Exclude files whose names match the supplied pattern." value="pattern" repeatable=#true {
            platform "macos"
        }
        argument "paths" summary="Paths to compare" description="Two files or directories to compare." required=#true repeatable=#true action="files"
    }

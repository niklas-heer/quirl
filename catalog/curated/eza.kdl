catalog "eza" {
    provenance author="Carapace contributors; curated by Quirl contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "eza" summary="List files with rich metadata" description="Lists files and directories with color, icons, Git state, tree views, and extended metadata." {
        intent "list files"
        intent "show a directory tree"
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "--absolute" summary="display entries with their absolute path" description="display entries with their absolute path" value="value"
        flag "--accessed" summary="use the accessed timestamp field" description="use the accessed timestamp field" short="-u"
        flag "--across" summary="sort the grid across, rather than downwards" description="sort the grid across, rather than downwards" short="-x"
        flag "--all" summary="show hidden and 'dot' files" description="show hidden and 'dot' files" short="-a" repeatable=#true
        flag "--almost-all" summary="equivalent to --all" description="equivalent to --all" short="-A" repeatable=#true
        flag "--binary" summary="list file sizes with binary prefixes" description="list file sizes with binary prefixes" short="-b"
        flag "--blocksize" summary="show size of allocated file system blocks" description="show size of allocated file system blocks" short="-S"
        flag "--bytes" summary="list file sizes in bytes, without any prefixes" description="list file sizes in bytes, without any prefixes" short="-B"
        flag "--changed" summary="use the changed timestamp field" description="use the changed timestamp field"
        flag "--classify" summary="display type indicator by file names" description="display type indicator by file names" short="-F" value="value"
        flag "--color" summary="when to use terminal colours" description="when to use terminal colours" value="value"
        flag "--color-scale" summary="highlight levels of 'field' distinctly" description="highlight levels of 'field' distinctly" value="value"
        flag "--color-scale-mode" summary="use gradient or fixed colors in --color-scale" description="use gradient or fixed colors in --color-scale" value="value"
        flag "--colour" summary="when to use terminal colours" description="when to use terminal colours" value="value"
        flag "--colour-scale" summary="highlight levels of 'field' distinctly" description="highlight levels of 'field' distinctly" value="value"
        flag "--colour-scale-mode" summary="use gradient or fixed colors in --color-scale" description="use gradient or fixed colors in --color-scale" value="value"
        flag "--context" summary="list each file's security context" description="list each file's security context" short="-Z"
        flag "--created" summary="use the created timestamp field" description="use the created timestamp field" short="-U"
        flag "--dereference" summary="dereference symbolic links when displaying information" description="dereference symbolic links when displaying information" short="-X"
        flag "--extended" summary="list each file's extended attributes and sizes" description="list each file's extended attributes and sizes"
        flag "--flags" summary="list file flags" description="list file flags" short="-O"
        flag "--follow-symlinks" summary="drill down into symbolic links that point to directories" description="drill down into symbolic links that point to directories"
        flag "--git" summary="list each file's Git status, if tracked or ignored" description="list each file's Git status, if tracked or ignored"
        flag "--git-ignore" summary="ignore files mentioned in '.gitignore'" description="ignore files mentioned in '.gitignore'"
        flag "--git-repos" summary="list root of git-tree status" description="list root of git-tree status"
        flag "--git-repos-no-status" summary="list each git-repos branch name" description="list each git-repos branch name"
        flag "--grid" summary="display entries as a grid" description="display entries as a grid" short="-G"
        flag "--group" summary="list each file's group" description="list each file's group" short="-g"
        flag "--group-directories-first" summary="list directories before other files" description="list directories before other files"
        flag "--group-directories-last" summary="list directories after other files" description="list directories after other files"
        flag "--header" summary="add a header row to each column" description="add a header row to each column" short="-h"
        flag "--help" summary="show list of command-line options" description="show list of command-line options"
        flag "--hyperlink" summary="display entries as hyperlinks" description="display entries as hyperlinks"
        flag "--icons" summary="when to display icons" description="when to display icons" value="value"
        flag "--ignore-glob" summary="glob patterns (pipe-separated) of files to ignore" description="glob patterns (pipe-separated) of files to ignore" short="-I" value="value"
        flag "--inode" summary="list each file's inode number" description="list each file's inode number" short="-i"
        flag "--level" summary="limit the depth of recursion" description="limit the depth of recursion" short="-L" value="value"
        flag "--links" summary="list each file's number of hard links" description="list each file's number of hard links" short="-H"
        flag "--long" summary="display extended file metadata as a table" description="display extended file metadata as a table" short="-l"
        flag "--modified" summary="use the modified timestamp field" description="use the modified timestamp field" short="-m"
        flag "--mounts" summary="show mount details" description="show mount details" short="-M"
        flag "--no-filesize" summary="suppress the filesize field" description="suppress the filesize field"
        flag "--no-git" summary="suppress Git status" description="suppress Git status"
        flag "--no-permissions" summary="suppress the permissions field" description="suppress the permissions field"
        flag "--no-quotes" summary="don't quote file names with spaces" description="don't quote file names with spaces"
        flag "--no-symlinks" summary="do not show symbolic links" description="do not show symbolic links"
        flag "--no-time" summary="suppress the time field" description="suppress the time field"
        flag "--no-user" summary="suppress the user field" description="suppress the user field"
        flag "--numeric" summary="list numeric user and group IDs" description="list numeric user and group IDs" short="-n"
        flag "--octal-permissions" summary="list each file's permission in octal format" description="list each file's permission in octal format" short="-o"
        flag "--oneline" summary="display one entry per line" description="display one entry per line" short="-1"
        flag "--only-dirs" summary="list only directories" description="list only directories" short="-D"
        flag "--only-files" summary="list only files" description="list only files" short="-f"
        flag "--recurse" summary="recurse into directories" description="recurse into directories" short="-R"
        flag "--reverse" summary="reverse the sort order" description="reverse the sort order" short="-r"
        flag "--show-symlinks" summary="explicitly show symbolic links" description="explicitly show symbolic links"
        flag "--smart-group" summary="only show group if it has a different name from owner" description="only show group if it has a different name from owner"
        flag "--sort" summary="which field to sort by" description="which field to sort by" short="-s" value="value"
        flag "--stdin" summary="read file names from stdin" description="read file names from stdin"
        flag "--time" summary="which timestamp field to list" description="which timestamp field to list" short="-t" value="value"
        flag "--time-style" summary="how to format timestamps" description="how to format timestamps" value="value"
        flag "--total-size" summary="show the size of a directory as the size of all" description="show the size of a directory as the size of all"
        flag "--treat-dirs-as-files" summary="list directories as files" description="list directories as files" short="-d"
        flag "--tree" summary="recurse into directories as a tree" description="recurse into directories as a tree" short="-T"
        flag "--version" summary="show version of eza" description="show version of eza" short="-v"
        flag "--width" summary="set screen width in columns" description="set screen width in columns" short="-w" value="value"
        argument "paths" summary="Paths to list" description="Files or directories to inspect; defaults to the current directory." repeatable=#true action="files"
    }
}

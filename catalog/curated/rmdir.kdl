catalog "rmdir" {
    provenance author="Carapace contributors; curated by Quirl contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "rmdir" summary="Remove empty directories" description="Removes selected empty directories or, on Windows, complete directory trees when explicitly requested." {
        intent "remove a directory"
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "--ignore-fail-on-non-empty" summary="Ignore nonempty directories" description="Ignore failures caused solely by a directory not being empty." {
            platform "linux"
        }
        flag "--parents" summary="Remove empty parent components" description="Remove the directory and then each empty parent path component." short="-p" {
            platform "linux"
        }
        flag "--verbose" summary="Show removed directories" description="Print a diagnostic for every processed directory." short="-v" {
            platform "linux"
        }
        flag "-p" summary="Remove empty parent components" description="Remove the directory and then each empty parent path component." {
            platform "macos"
            platform "freebsd"
        }
        flag "-v" summary="Show removed directories" description="Print each directory as it is removed." {
            platform "macos"
            platform "freebsd"
        }
        flag "/q" summary="Do not prompt for confirmation" description="Use quiet mode when removing a directory tree." {
            platform "windows"
        }
        flag "/s" summary="Remove an entire directory tree" description="Remove the selected directory together with all files and subdirectories." {
            platform "windows"
        }
        argument "directories" summary="Directories to remove" description="One or more directory paths to remove." required=#true repeatable=#true action="directories"
    }
}

catalog "rm" {
    provenance author="Carapace contributors; curated by Quirl contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "rm" summary="Remove files or directories" description="Removes selected paths; directories require an explicit recursive or directory option." {
        intent "delete a file"
        intent "remove a directory"
        platform "linux"
        platform "macos"
        platform "freebsd"
        flag "--dir" summary="remove empty directories" description="remove empty directories" short="-d" {
            platform "linux"
            platform "freebsd"
        }
        flag "--force" summary="ignore nonexistent files and arguments, never prompt" description="ignore nonexistent files and arguments, never prompt" short="-f" {
            platform "linux"
            platform "freebsd"
        }
        flag "--help" summary="display this help and exit" description="display this help and exit" {
            platform "linux"
            platform "freebsd"
        }
        flag "--interactive" summary="prompt according to WHEN: never, once (-I), or always (-i); without WHEN, prompt always" description="prompt according to WHEN: never, once (-I), or always (-i); without WHEN, prompt always" value="value" {
            platform "linux"
            platform "freebsd"
        }
        flag "--no-preserve-root" summary="do not treat '/' specially" description="do not treat '/' specially" {
            platform "linux"
            platform "freebsd"
        }
        flag "--one-file-system" summary="when removing a hierarchy recursively, skip any directory that is on a file system different from that of the corresponding command line argument" description="when removing a hierarchy recursively, skip any directory that is on a file system different from that of the corresponding command line argument" {
            platform "linux"
            platform "freebsd"
        }
        flag "--preserve-root" summary="do not remove '/' (default); with 'all', reject any command line argument on a separate device from its parent" description="do not remove '/' (default); with 'all', reject any command line argument on a separate device from its parent" value="value" {
            platform "linux"
            platform "freebsd"
        }
        flag "--recursive" summary="remove directories and their contents recursively" description="remove directories and their contents recursively" short="-r" {
            platform "linux"
            platform "freebsd"
        }
        flag "--verbose" summary="explain what is being done" description="explain what is being done" short="-v" {
            platform "linux"
            platform "freebsd"
        }
        flag "--version" summary="output version information and exit" description="output version information and exit" {
            platform "linux"
            platform "freebsd"
        }
        flag "-I" summary="Prompt once for risky removals" description="Ask once before removing more than three files or recursively removing a directory." {
            platform "macos"
        }
        flag "-P" summary="Retain historical compatibility" description="Accept the historical secure-overwrite option without changing behavior." {
            platform "macos"
        }
        flag "-R" summary="Remove directories recursively" description="Remove each selected directory hierarchy and its contents." {
            platform "macos"
        }
        flag "-W" summary="Attempt to undelete whiteouts" description="Attempt to recover files represented by union-filesystem whiteouts." {
            platform "macos"
        }
        flag "-d" summary="Remove directories" description="Attempt to remove directories as well as other filesystem entries." {
            platform "macos"
        }
        flag "-f" summary="Remove without prompting" description="Ignore nonexistent paths and do not ask for confirmation." {
            platform "macos"
        }
        flag "-i" summary="Prompt before every removal" description="Ask for confirmation before removing each path." {
            platform "linux"
            platform "freebsd"
        }
        flag "-i" summary="Prompt before each removal" description="Ask for confirmation before removing every selected entry." {
            platform "macos"
        }
        flag "-r" summary="Remove directories recursively" description="Remove each selected directory hierarchy and its contents." {
            platform "macos"
        }
        flag "-v" summary="Show removed paths" description="Print each path as it is removed." {
            platform "macos"
        }
        flag "-x" summary="Stay on one filesystem" description="Do not cross mount points while recursively removing a hierarchy." {
            platform "macos"
        }
        argument "paths" summary="Paths to remove" description="Files or directories selected for removal." required=#true repeatable=#true action="files"
    }
}

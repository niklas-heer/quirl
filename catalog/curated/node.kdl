catalog "node" {
    provenance author="Carapace contributors; curated by Quirl contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "node" summary="Run JavaScript with Node.js" description="Evaluates JavaScript, executes a script or module, or starts an interactive Node.js session." {
        intent "run a javascript file"
        intent "start a node repl"
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "--abort-on-uncaught-exception" summary="aborting instead of exiting causes a core file to be generated for analysis" description="aborting instead of exiting causes a core file to be generated for analysis"
        flag "--allow-addons" summary="allow use of addons when any permissions are set" description="allow use of addons when any permissions are set"
        flag "--allow-child-process" summary="allow use of child process when any permissions are set" description="allow use of child process when any permissions are set"
        flag "--allow-ffi" summary="allow use of FFI when any permissions are set" description="allow use of FFI when any permissions are set"
        flag "--allow-fs-read" summary="allow permissions to read the filesystem" description="allow permissions to read the filesystem" value="value"
        flag "--allow-fs-write" summary="allow permissions to write in the filesystem" description="allow permissions to write in the filesystem" value="value"
        flag "--allow-inspector" summary="allow use of inspector when any permissions are set" description="allow use of inspector when any permissions are set"
        flag "--allow-net" summary="allow network access when any permissions are set" description="allow network access when any permissions are set"
        flag "--allow-wasi" summary="allow wasi when any permissions are set" description="allow wasi when any permissions are set"
        flag "--allow-worker" summary="allow worker threads when any permissions are set" description="allow worker threads when any permissions are set"
        flag "--build-sea" summary="Generate a single executable application from the current script" description="Generate a single executable application from the current script"
        flag "--build-snapshot" summary="Generate a snapshot blob when the process exits" description="Generate a snapshot blob when the process exits"
        flag "--build-snapshot-config" summary="specify the path to the snapshot configuration file" description="specify the path to the snapshot configuration file" value="value" action="files"
        flag "--check" summary="syntax check script without executing" description="syntax check script without executing" short="-c"
        flag "--completion-bash" summary="print source-able bash completion script" description="print source-able bash completion script"
        flag "--conditions" summary="additional user conditions for conditional exports and imports" description="additional user conditions for conditional exports and imports" short="-C" value="value"
        flag "--cpu-prof" summary="Start the V8 CPU profiler on start up" description="Start the V8 CPU profiler on start up"
        flag "--cpu-prof-dir" summary="Directory where the V8 profiles generated by --cpu-prof will be placed" description="Directory where the V8 profiles generated by --cpu-prof will be placed" value="value" action="directories"
        flag "--cpu-prof-interval" summary="specified sampling interval in microseconds for the V8 CPU profile" description="specified sampling interval in microseconds for the V8 CPU profile" value="value"
        flag "--cpu-prof-name" summary="specified file name of the V8 CPU profile generated with --cpu-prof" description="specified file name of the V8 CPU profile generated with --cpu-prof" value="value"
        flag "--debug-port" summary="set host:port for inspector" description="set host:port for inspector"
        flag "--diagnostic-dir" summary="set dir for all output files" description="set dir for all output files" value="value" action="directories"
        flag "--disable-proto" summary="disable Object.prototype.__proto__" description="disable Object.prototype.__proto__" value="value"
        flag "--disable-sigusr1" summary="Disable inspector thread to be listening for SIGUSR1 signal" description="Disable inspector thread to be listening for SIGUSR1 signal"
        flag "--disable-warning" summary="silence specific process warnings" description="silence specific process warnings" value="value"
        flag "--disable-wasm-trap-handler" summary="disable Wasm trap handler support" description="disable Wasm trap handler support"
        flag "--disallow-code-generation-from-strings" summary="disallow eval and friends" description="disallow eval and friends"
        flag "--dns-result-order" summary="set default value of verbatim in dns.lookup" description="set default value of verbatim in dns.lookup" value="value"
        flag "--enable-etw-stack-walking" summary="provides heap data to ETW Windows native tracing" description="provides heap data to ETW Windows native tracing"
        flag "--enable-fips" summary="enable FIPS crypto at startup" description="enable FIPS crypto at startup"
        flag "--enable-network-family-autoselection" summary="Enable network address family autodetection algorithm" description="Enable network address family autodetection algorithm"
        flag "--enable-source-maps" summary="Source Map V3 support for stack traces" description="Source Map V3 support for stack traces"
        flag "--entry-url" summary="Treat the entrypoint as a URL" description="Treat the entrypoint as a URL"
        flag "--env-file" summary="set environment variables from supplied file" description="set environment variables from supplied file" value="value" action="files"
        flag "--env-file-if-exists" summary="set environment variables from supplied file" description="set environment variables from supplied file" value="value" action="files"
        flag "--eval" summary="evaluate script" description="evaluate script" short="-e" value="value"
        flag "--experimental-addon-modules" summary="experimental import support for addons" description="experimental import support for addons"
        flag "--experimental-config-file" summary="set config file from supplied file" description="set config file from supplied file" value="value" action="files"
        flag "--experimental-default-config-file" summary="set config file from default config file" description="set config file from default config file"
        flag "--experimental-eventsource" summary="experimental EventSource API" description="experimental EventSource API"
        flag "--experimental-ffi" summary="experimental FFI support" description="experimental FFI support"
        flag "--experimental-import-meta-resolve" summary="experimental ES Module import.meta.resolve() parentURL support" description="experimental ES Module import.meta.resolve() parentURL support"
        flag "--experimental-inspector-network-resource" summary="experimental load network resources via the inspector" description="experimental load network resources via the inspector"
        flag "--experimental-network-inspection" summary="experimental network inspection support" description="experimental network inspection support"
        flag "--experimental-print-required-tla" summary="Print pending top-level await" description="Print pending top-level await"
        flag "--experimental-sea-config" summary="Generate a blob that can be embedded into the single executable application" description="Generate a blob that can be embedded into the single executable application" value="value"
        flag "--experimental-storage-inspection" summary="experimental storage inspection support" description="experimental storage inspection support"
        flag "--experimental-stream-iter" summary="experimental async iterator support for streams" description="experimental async iterator support for streams"
        flag "--experimental-strip-types" summary="experimental type stripping for TypeScript files" description="experimental type stripping for TypeScript files"
        flag "--experimental-test-coverage" summary="enable code coverage in the test runner" description="enable code coverage in the test runner"
        flag "--experimental-test-isolation" summary="configures the type of test isolation used in the test runner" description="configures the type of test isolation used in the test runner"
        flag "--experimental-test-module-mocks" summary="enable module mocking in the test runner" description="enable module mocking in the test runner"
        flag "--experimental-test-tag-filter" summary="run tests whose tags match this filter" description="run tests whose tags match this filter" value="value"
        flag "--experimental-transform-types" summary="enable transformation of TypeScript-onlysyntax into JavaScript code" description="enable transformation of TypeScript-onlysyntax into JavaScript code"
        flag "--experimental-vm-modules" summary="experimental ES Module support in vm module" description="experimental ES Module support in vm module"
        flag "--experimental-webstorage" summary="experimental Web Storage API" description="experimental Web Storage API"
        flag "--experimental-worker-inspection" summary="experimental worker inspection support" description="experimental worker inspection support"
        flag "--expose-gc" summary="expose gc extension" description="expose gc extension"
        flag "--force-context-aware" summary="disable loading non-context-aware addons" description="disable loading non-context-aware addons"
        flag "--force-fips" summary="force FIPS crypto (cannot be disabled)" description="force FIPS crypto (cannot be disabled)"
        flag "--force-node-api-uncaught-exceptions-policy" summary="enforces 'uncaughtException' event on Node API asynchronous callbacks" description="enforces 'uncaughtException' event on Node API asynchronous callbacks"
        flag "--frozen-intrinsics" summary="experimental frozen intrinsics support" description="experimental frozen intrinsics support"
        flag "--heap-prof" summary="Start the V8 heap profiler on start up, and write the heap profile to disk before exit" description="Start the V8 heap profiler on start up, and write the heap profile to disk before exit"
        flag "--heap-prof-dir" summary="Directory where the V8 heap profiles generated by --heap-prof will be placed" description="Directory where the V8 heap profiles generated by --heap-prof will be placed" value="value" action="directories"
        flag "--heap-prof-interval" summary="specified sampling interval in bytes for the V8 heap profile generated" description="specified sampling interval in bytes for the V8 heap profile generated" value="value"
        flag "--heap-prof-name" summary="specified file name of the V8 heap profile generated with --heap-prof" description="specified file name of the V8 heap profile generated with --heap-prof" value="value"
        flag "--heapsnapshot-near-heap-limit" summary="Generate heap snapshots whenever V8 is approaching the heap limit" description="Generate heap snapshots whenever V8 is approaching the heap limit" value="value"
        flag "--heapsnapshot-signal" summary="Generate heap snapshot on specified signal" description="Generate heap snapshot on specified signal" value="value"
        flag "--help" summary="print node command line options" description="print node command line options" short="-h"
        flag "--icu-data-dir" summary="set ICU data load path to dir" description="set ICU data load path to dir" value="value" action="directories"
        flag "--import" summary="ES module to preload" description="ES module to preload" value="value"
        flag "--input-type" summary="set module type for string input" description="set module type for string input" value="value"
        flag "--insecure-http-parser" summary="use an insecure HTTP parser that accepts invalid HTTP headers" description="use an insecure HTTP parser that accepts invalid HTTP headers"
        flag "--inspect" summary="activate inspector on host:port" description="activate inspector on host:port" value="value"
        flag "--inspect-brk" summary="activate inspector on host:port and break before user code starts" description="activate inspector on host:port and break before user code starts" value="value"
        flag "--inspect-port" summary="set host:port for inspector" description="set host:port for inspector" value="value"
        flag "--inspect-publish-uid" summary="comma separated list of destinations for inspector" description="comma separated list of destinations for inspector" value="value"
        flag "--inspect-wait" summary="activate inspector on host:port and wait for debugger to be attached" description="activate inspector on host:port and wait for debugger to be attached" value="value"
        flag "--interactive" summary="always enter the REPL even if stdin does not appear to be a terminal" description="always enter the REPL even if stdin does not appear to be a terminal" short="-i"
        flag "--interpreted-frames-native-stack" summary="help system profilers to translate JavaScript interpreted frames" description="help system profilers to translate JavaScript interpreted frames"
        flag "--jitless" summary="disable runtime allocation of executable memory" description="disable runtime allocation of executable memory"
        flag "--loader" summary="use the specified module as a custom loader" description="use the specified module as a custom loader" value="value"
        flag "--localstorage-file" summary="file used to persist localStorage data" description="file used to persist localStorage data" value="value" action="files"
        flag "--max-http-header-size" summary="set the maximum size of HTTP headers" description="set the maximum size of HTTP headers" value="value"
        flag "--max-old-space-size" summary="set V8's max old space size in MB" description="set V8's max old space size in MB" value="value"
        flag "--max-old-space-size-percentage" summary="set V8's max old space size as a percentage of available memory" description="set V8's max old space size as a percentage of available memory" value="value"
        flag "--network-family-autoselection-attempt-timeout" summary="Sets the default value for the network family autoselection attempt timeout" description="Sets the default value for the network family autoselection attempt timeout" value="value"
        flag "--no-addons" summary="disable loading native addons" description="disable loading native addons"
        flag "--no-async-context-frame" summary="Improve AsyncLocalStorage performance with AsyncContextFrame" description="Improve AsyncLocalStorage performance with AsyncContextFrame"
        flag "--no-deprecation" summary="silence deprecation warnings" description="silence deprecation warnings"
        flag "--no-experimental-detect-module" summary="when ambiguous modules fail to evaluate because they contain ES module syntax, try again to evaluate them as ES modules" description="when ambiguous modules fail to evaluate because they contain ES module syntax, try again to evaluate them as ES modules"
        flag "--no-experimental-global-navigator" summary="expose experimental Navigator API on the global scope" description="expose experimental Navigator API on the global scope"
        flag "--no-experimental-repl-await" summary="experimental await keyword support in REPL" description="experimental await keyword support in REPL"
        flag "--no-experimental-require-module" summary="Allow loading synchronous ES Modules in require()" description="Allow loading synchronous ES Modules in require()"
        flag "--no-experimental-sqlite" summary="experimental node:sqlite module" description="experimental node:sqlite module"
        flag "--no-experimental-strip-types" summary="Experimental type-stripping for TypeScript files" description="Experimental type-stripping for TypeScript files"
        flag "--no-experimental-websocket" summary="experimental WebSocket API" description="experimental WebSocket API"
        flag "--no-extra-info-on-fatal-exception" summary="hide extra information on fatal exception that causes exit" description="hide extra information on fatal exception that causes exit"
        flag "--no-force-async-hooks-checks" summary="disable checks for async_hooks" description="disable checks for async_hooks"
        flag "--no-global-search-paths" summary="disable global module search paths" description="disable global module search paths"
        flag "--no-network-family-autoselection" summary="Disable network address family autodetection algorithm" description="Disable network address family autodetection algorithm"
        flag "--no-require-module" summary="disable loading synchronous ES Modules in require()" description="disable loading synchronous ES Modules in require()"
        flag "--no-warnings" summary="silence all process warnings" description="silence all process warnings"
        flag "--node-memory-debug" summary="Run with extra debug checks for memory leaks in Node.js itself" description="Run with extra debug checks for memory leaks in Node.js itself"
        flag "--openssl-config" summary="load OpenSSL configuration from the specified file" description="load OpenSSL configuration from the specified file" value="value" action="files"
        flag "--openssl-legacy-provider" summary="enable OpenSSL 3.0 legacy provider" description="enable OpenSSL 3.0 legacy provider"
        flag "--openssl-shared-config" summary="enable OpenSSL shared configuration" description="enable OpenSSL shared configuration"
        flag "--pending-deprecation" summary="emit pending deprecation warnings" description="emit pending deprecation warnings"
        flag "--permission" summary="enable the permission system" description="enable the permission system"
        flag "--permission-audit" summary="enable permission audit logging" description="enable permission audit logging"
        flag "--preserve-symlinks" summary="preserve symbolic links when resolving" description="preserve symbolic links when resolving"
        flag "--preserve-symlinks-main" summary="preserve symbolic links when resolving the main module" description="preserve symbolic links when resolving the main module"
        flag "--print" summary="evaluate script and print result" description="evaluate script and print result" short="-p" value="value"
        flag "--prof" summary="Generate V8 profiler output" description="Generate V8 profiler output"
        flag "--prof-process" summary="process V8 profiler output generated using --prof" description="process V8 profiler output generated using --prof"
        flag "--redirect-warnings" summary="write warnings to file instead of stderr" description="write warnings to file instead of stderr" value="value" action="files"
        flag "--report-compact" summary="output compact single-line JSON" description="output compact single-line JSON"
        flag "--report-dir" summary="define custom report pathname" description="define custom report pathname" value="value" action="directories"
        flag "--report-directory" summary="define custom report pathname" description="define custom report pathname" value="value" action="directories"
        flag "--report-exclude-env" summary="Exclude environment variables when generating report" description="Exclude environment variables when generating report"
        flag "--report-exclude-network" summary="exclude network interface diagnostics" description="exclude network interface diagnostics"
        flag "--report-filename" summary="define custom report file name" description="define custom report file name" value="value"
        flag "--report-on-fatalerror" summary="generate diagnostic report on fatal (internal) errors" description="generate diagnostic report on fatal (internal) errors"
        flag "--report-on-signal" summary="generate diagnostic report upon receiving signals" description="generate diagnostic report upon receiving signals"
        flag "--report-signal" summary="causes diagnostic report to be produced on provided signal" description="causes diagnostic report to be produced on provided signal" value="value"
        flag "--report-uncaught-exception" summary="generate diagnostic report on uncaught exceptions" description="generate diagnostic report on uncaught exceptions"
        flag "--require" summary="CommonJS module to preload" description="CommonJS module to preload" short="-r" value="value"
        flag "--require-module" summary="Allow loading synchronous ES Modules in require()" description="Allow loading synchronous ES Modules in require()"
        flag "--run" summary="Run a script specified in package.json" description="Run a script specified in package.json" value="value"
        flag "--secure-heap" summary="total size of the OpenSSL secure heap" description="total size of the OpenSSL secure heap" value="value"
        flag "--secure-heap-min" summary="minimum allocation size from the OpenSSL secure heap" description="minimum allocation size from the OpenSSL secure heap" value="value"
        flag "--snapshot-blob" summary="Path to the snapshot blob that's either the result of snapshotbuilding" description="Path to the snapshot blob that's either the result of snapshotbuilding" value="value"
        flag "--test" summary="launch test runner on startup" description="launch test runner on startup"
        flag "--test-concurrency" summary="specify test runner concurrency" description="specify test runner concurrency" value="value"
        flag "--test-coverage-branches" summary="the branch coverage minimum threshold" description="the branch coverage minimum threshold" value="value"
        flag "--test-coverage-exclude" summary="exclude files from coverage report that match this glob pattern" description="exclude files from coverage report that match this glob pattern" value="value"
        flag "--test-coverage-functions" summary="the function coverage minimum threshold" description="the function coverage minimum threshold" value="value"
        flag "--test-coverage-include" summary="include files in coverage report that match this glob pattern" description="include files in coverage report that match this glob pattern" value="value"
        flag "--test-coverage-lines" summary="the line coverage minimum threshold" description="the line coverage minimum threshold" value="value"
        flag "--test-force-exit" summary="force test runner to exit upon completion" description="force test runner to exit upon completion"
        flag "--test-global-setup" summary="specifies the path to the global setup file" description="specifies the path to the global setup file" value="value"
        flag "--test-isolation" summary="configures the type of test isolation used in the test runner" description="configures the type of test isolation used in the test runner" value="value"
        flag "--test-name-pattern" summary="run tests whose name matches this regular expression" description="run tests whose name matches this regular expression" value="value"
        flag "--test-only" summary="run tests with 'only' option set" description="run tests with 'only' option set"
        flag "--test-random-seed" summary="seed for randomizing test execution order" description="seed for randomizing test execution order" value="value"
        flag "--test-randomize" summary="randomize test execution order" description="randomize test execution order"
        flag "--test-reporter" summary="report test output using the given reporter" description="report test output using the given reporter" value="value"
        flag "--test-reporter-destination" summary="report given reporter to the given destination" description="report given reporter to the given destination" value="value"
        flag "--test-rerun-failures" summary="specifies the path to the rerun state file" description="specifies the path to the rerun state file" value="value" action="files"
        flag "--test-shard" summary="run test at specific shard" description="run test at specific shard" value="value"
        flag "--test-skip-pattern" summary="run tests whose name do not match this regular expression" description="run tests whose name do not match this regular expression" value="value"
        flag "--test-timeout" summary="specify test runner timeout" description="specify test runner timeout" value="value"
        flag "--test-update-snapshots" summary="regenerate test snapshots" description="regenerate test snapshots"
        flag "--throw-deprecation" summary="throw an exception on deprecations" description="throw an exception on deprecations"
        flag "--title" summary="the process title to use on startup" description="the process title to use on startup" value="value"
        flag "--tls-cipher-list" summary="use an alternative default TLS cipher list" description="use an alternative default TLS cipher list" value="value"
        flag "--tls-keylog" summary="log TLS decryption keys to named file for traffic analysis" description="log TLS decryption keys to named file for traffic analysis" value="value" action="files"
        flag "--trace-deprecation" summary="show stack traces on deprecations" description="show stack traces on deprecations"
        flag "--trace-env" summary="Print accesses to the environment variables" description="Print accesses to the environment variables"
        flag "--trace-env-js-stack" summary="Print accesses to the environment variables and the JavaScript stack trace" description="Print accesses to the environment variables and the JavaScript stack trace"
        flag "--trace-env-native-stack" summary="Print accesses to the environment variables and the native stack trace" description="Print accesses to the environment variables and the native stack trace"
        flag "--trace-event-categories" summary="comma separated list of trace event categories to record" description="comma separated list of trace event categories to record" value="value"
        flag "--trace-event-file-pattern" summary="Template string specifying the filepath for the trace-events data" description="Template string specifying the filepath for the trace-events data" value="value"
        flag "--trace-exit" summary="show stack trace when an environment exits" description="show stack trace when an environment exits"
        flag "--trace-promises" summary="show stack traces on promise initialization and resolution" description="show stack traces on promise initialization and resolution"
        flag "--trace-require-module" summary="Print access to require(esm)" description="Print access to require(esm)" value="value"
        flag "--trace-sigint" summary="enable printing JavaScript stacktrace on SIGINT" description="enable printing JavaScript stacktrace on SIGINT"
        flag "--trace-sync-io" summary="show stack trace when use of sync IO is detected after the first tick" description="show stack trace when use of sync IO is detected after the first tick"
        flag "--trace-tls" summary="prints TLS packet trace information to stderr" description="prints TLS packet trace information to stderr"
        flag "--trace-uncaught" summary="show stack traces for the `throw` behind uncaught exceptions" description="show stack traces for the `throw` behind uncaught exceptions"
        flag "--trace-warnings" summary="show stack traces on process warnings" description="show stack traces on process warnings"
        flag "--track-heap-objects" summary="track heap object allocations for heap snapshots" description="track heap object allocations for heap snapshots"
        flag "--unhandled-rejections" summary="define unhandled rejections behavior" description="define unhandled rejections behavior" value="value"
        flag "--use-bundled-ca" summary="use bundled CA store (default)" description="use bundled CA store (default)"
        flag "--use-env-proxy" summary="parse proxy settings from HTTP_PROXY/HTTPS_PROXY/NO_PROXYenvironment variables" description="parse proxy settings from HTTP_PROXY/HTTPS_PROXY/NO_PROXYenvironment variables"
        flag "--use-largepages" summary="Map the Node.js static code to large pages" description="Map the Node.js static code to large pages" value="value"
        flag "--use-openssl-ca" summary="use OpenSSL's default CA store" description="use OpenSSL's default CA store"
        flag "--use-system-ca" summary="use system's CA store" description="use system's CA store"
        flag "--v8-options" summary="print V8 command line options" description="print V8 command line options"
        flag "--v8-pool-size" summary="set V8's thread pool size" description="set V8's thread pool size" value="value"
        flag "--version" summary="print Node.js version" description="print Node.js version" short="-v"
        flag "--watch" summary="run in watch mode" description="run in watch mode"
        flag "--watch-kill-signal" summary="kill signal to send to the process on watch mode restarts" description="kill signal to send to the process on watch mode restarts" value="value"
        flag "--watch-path" summary="path to watch" description="path to watch" value="value" action="directories"
        flag "--watch-preserve-output" summary="preserve outputs on watch mode restart" description="preserve outputs on watch mode restart"
        flag "--webstorage" summary="experimental Web Storage API" description="experimental Web Storage API"
        flag "--zero-fill-buffers" summary="automatically zero-fill all newly allocated Buffer and SlowBuffer instances" description="automatically zero-fill all newly allocated Buffer and SlowBuffer instances"
        argument "script" summary="JavaScript entry file" description="Script or module to execute; omit it to read input or start an interactive session." action="files"
        argument "arguments" summary="Script arguments" description="Values exposed to the executed program after the entry file." repeatable=#true
    }
}

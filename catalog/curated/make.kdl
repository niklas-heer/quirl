catalog "make" {
    provenance author="Carapace contributors; curated by Quirl contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "make" summary="Build targets from makefiles" description="Updates named targets by evaluating dependencies and recipes from makefiles." {
        intent "build a project"
        intent "run a make target"
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "--always-make" summary="Unconditionally make all targets." description="Unconditionally make all targets." short="-B"
        flag "--assume-new" summary="Consider FILE to be infinitely new." description="Consider FILE to be infinitely new." value="value" action="files"
        flag "--assume-old" summary="Consider FILE to be very old and don't remake it." description="Consider FILE to be very old and don't remake it." value="value" action="files"
        flag "--check-symlink-times" summary="Use the latest mtime between symlinks and target." description="Use the latest mtime between symlinks and target." short="-L"
        flag "--debug" summary="Print various types of debugging information." description="Print various types of debugging information." value="value"
        flag "--directory" summary="Change to DIRECTORY before doing anything." description="Change to DIRECTORY before doing anything." short="-C" value="value" action="directories"
        flag "--dry-run" summary="Don't actually run any recipe; just print them." description="Don't actually run any recipe; just print them."
        flag "--environment-overrides" summary="Environment variables override makefiles." description="Environment variables override makefiles." short="-e"
        flag "--eval" summary="Evaluate STRING as a makefile statement." description="Evaluate STRING as a makefile statement." short="-E" value="value"
        flag "--file" summary="Read FILE as a makefile." description="Read FILE as a makefile." short="-f" value="value" action="files"
        flag "--help" summary="Print this message and exit." description="Print this message and exit." short="-h"
        flag "--ignore-errors" summary="Ignore errors from recipes." description="Ignore errors from recipes." short="-i"
        flag "--include-dir" summary="Search DIRECTORY for included makefiles." description="Search DIRECTORY for included makefiles." short="-I" value="value" action="directories"
        flag "--jobs" summary="Allow N jobs at once; infinite jobs with no arg." description="Allow N jobs at once; infinite jobs with no arg." short="-j" value="value"
        flag "--jobserver-style" summary="Select the style of jobserver to use." description="Select the style of jobserver to use." value="value"
        flag "--just-print" summary="Don't actually run any recipe; just print them." description="Don't actually run any recipe; just print them." short="-n"
        flag "--keep-going" summary="Keep going when some targets can't be made." description="Keep going when some targets can't be made." short="-k"
        flag "--load-average" summary="Don't start multiple jobs unless load is below N." description="Don't start multiple jobs unless load is below N." short="-l" value="value"
        flag "--makefile" summary="Read FILE as a makefile." description="Read FILE as a makefile." value="value"
        flag "--max-load" summary="Don't start multiple jobs unless load is below N." description="Don't start multiple jobs unless load is below N." value="value"
        flag "--new-file" summary="Consider FILE to be infinitely new." description="Consider FILE to be infinitely new." value="value" action="files"
        flag "--no-builtin-rules" summary="Disable the built-in implicit rules." description="Disable the built-in implicit rules." short="-r"
        flag "--no-builtin-variables" summary="Disable the built-in variable settings." description="Disable the built-in variable settings." short="-R"
        flag "--no-keep-going" summary="Turns off -k." description="Turns off -k." short="-S"
        flag "--no-print-directory" summary="Turn off -w, even if it was turned on implicitly." description="Turn off -w, even if it was turned on implicitly."
        flag "--no-silent" summary="Echo recipes (disable --silent mode)." description="Echo recipes (disable --silent mode)."
        flag "--old-file" summary="Consider FILE to be very old and don't remake it." description="Consider FILE to be very old and don't remake it." short="-o" value="value" action="files"
        flag "--output-sync" summary="Synchronize output of parallel jobs by TYPE." description="Synchronize output of parallel jobs by TYPE." short="-O" value="value"
        flag "--print-data-base" summary="Print make's internal database." description="Print make's internal database." short="-p"
        flag "--print-directory" summary="Print the current directory." description="Print the current directory." short="-w"
        flag "--question" summary="Run no recipe; exit status says if up to date." description="Run no recipe; exit status says if up to date." short="-q"
        flag "--quiet" summary="Don't echo recipes." description="Don't echo recipes."
        flag "--recon" summary="Don't actually run any recipe; just print them." description="Don't actually run any recipe; just print them."
        flag "--shuffle" summary="Perform shuffle of prerequisites and goals." description="Perform shuffle of prerequisites and goals." value="value"
        flag "--silent" summary="Don't echo recipes." description="Don't echo recipes." short="-s"
        flag "--stop" summary="Turns off -k." description="Turns off -k."
        flag "--touch" summary="Touch targets instead of remaking them." description="Touch targets instead of remaking them." short="-t"
        flag "--trace" summary="Print tracing information." description="Print tracing information."
        flag "--version" summary="Print the version number of make and exit." description="Print the version number of make and exit." short="-v"
        flag "--warn-undefined-variables" summary="Warn when an undefined variable is referenced." description="Warn when an undefined variable is referenced."
        flag "--what-if" summary="Consider FILE to be infinitely new." description="Consider FILE to be infinitely new." short="-W" value="value" action="files"
        flag "-d" summary="Print lots of debugging information." description="Print lots of debugging information."
        argument "targets" summary="Targets or variable assignments" description="Targets to update and optional name=value assignments." repeatable=#true
    }
}

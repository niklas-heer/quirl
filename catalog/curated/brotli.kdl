catalog "brotli" {
    provenance author="Carapace contributors; curated by Quirl contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "brotli" summary="Compress or decompress files with Brotli" description="Compresses files into Brotli format or restores Brotli-compressed data." {
        intent "compress a file"
        intent "decompress a brotli file"
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "--best" summary="use best compression level (11) (default)" description="use best compression level (11) (default)" short="-Z"
        flag "--comment" summary="set comment; argument is base64-decoded first" description="set comment; argument is base64-decoded first" short="-C" value="value"
        flag "--concatenated" summary="allows concatenated brotli streams as input" description="allows concatenated brotli streams as input"
        flag "--decompress" summary="decompress" description="decompress" short="-d"
        flag "--dictionary" summary="use FILE as raw (LZ77) dictionary" description="use FILE as raw (LZ77) dictionary" short="-D" value="value" action="files"
        flag "--force" summary="force output file overwrite" description="force output file overwrite" short="-f"
        flag "--help" summary="display this help and exit" description="display this help and exit" short="-h"
        flag "--keep" summary="keep source file(s) (default)" description="keep source file(s) (default)" short="-k"
        flag "--lgwin" summary="set LZ77 window size" description="set LZ77 window size" short="-w" value="value"
        flag "--no-copy-stat" summary="do not copy source file(s) attributes" description="do not copy source file(s) attributes" short="-n"
        flag "--output" summary="output file (only if 1 input file)" description="output file (only if 1 input file)" short="-o" value="value" action="files"
        flag "--quality" summary="compression level (0-11)" description="compression level (0-11)" short="-q" value="value"
        flag "--rm" summary="remove source file(s)" description="remove source file(s)" short="-j"
        flag "--squash" summary="remove destination file if larger than source" description="remove destination file if larger than source" short="-s"
        flag "--stdout" summary="write on standard output" description="write on standard output" short="-c"
        flag "--suffix" summary="output file suffix (default:'.br')" description="output file suffix (default:'.br')" short="-S" value="value"
        flag "--test" summary="test compressed file integrity" description="test compressed file integrity" short="-t"
        flag "--verbose" summary="verbose mode" description="verbose mode" short="-v"
        flag "--version" summary="display version and exit" description="display version and exit" short="-V"
        flag "-0" summary="compression level" description="compression level"
        flag "-1" summary="compression level" description="compression level"
        flag "-2" summary="compression level" description="compression level"
        flag "-3" summary="compression level" description="compression level"
        flag "-4" summary="compression level" description="compression level"
        flag "-5" summary="compression level" description="compression level"
        flag "-6" summary="compression level" description="compression level"
        flag "-7" summary="compression level" description="compression level"
        flag "-8" summary="compression level" description="compression level"
        flag "-9" summary="compression level" description="compression level"
        argument "files" summary="Input files" description="Files to compress or decompress; omit them to use standard input." repeatable=#true action="files"
    }
}

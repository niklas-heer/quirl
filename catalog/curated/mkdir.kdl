catalog "mkdir" {
    provenance author="Carapace contributors; curated by Quirl contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "mkdir" summary="Create directories" description="Creates one or more directories on Windows." {
        intent "create a directory"
        platform "windows"
        argument "directories" summary="Directories to create" description="One or more directory paths to create." required=#true repeatable=#true action="directories"
    }
}

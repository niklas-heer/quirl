catalog "zip" {
    provenance author="Carapace contributors; curated by Quirl contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "zip" summary="Create or update ZIP archives" description="Packages and compresses files into a ZIP archive or updates an existing archive." {
        intent "add files to a zip archive"
        intent "create a zip archive"
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "-0" summary="store only" description="store only"
        flag "-1" summary="compress faster" description="compress faster"
        flag "-9" summary="compress better" description="compress better"
        flag "-A" summary="adjust self-extracting exe" description="adjust self-extracting exe"
        flag "-D" summary="do not add directory entries" description="do not add directory entries"
        flag "-F" summary="fix zipfile (-FF try harder)" description="fix zipfile (-FF try harder)"
        flag "-J" summary="junk zipfile prefix (unzipsfx)" description="junk zipfile prefix (unzipsfx)"
        flag "-T" summary="test zipfile integrity" description="test zipfile integrity"
        flag "-X" summary="eXclude eXtra file attributes" description="eXclude eXtra file attributes"
        flag "-c" summary="add one-line comments" description="add one-line comments"
        flag "-d" summary="delete entries in zipfile" description="delete entries in zipfile"
        flag "-e" summary="encrypt" description="encrypt"
        flag "-f" summary="freshen: only changed files" description="freshen: only changed files"
        flag "-i" summary="include only the following names" description="include only the following names"
        flag "-j" summary="junk (don't record) directory names" description="junk (don't record) directory names"
        flag "-l" summary="convert LF to CR LF" description="convert LF to CR LF"
        flag "-m" summary="move into zipfile (delete OS files)" description="move into zipfile (delete OS files)"
        flag "-n" summary="don't compress these suffixes" description="don't compress these suffixes" value="value"
        flag "-o" summary="make zipfile as old as latest entry" description="make zipfile as old as latest entry"
        flag "-q" summary="quiet operation" description="quiet operation"
        flag "-r" summary="recurse into directories" description="recurse into directories"
        flag "-u" summary="update: only changed or new files" description="update: only changed or new files"
        flag "-v" summary="verbose operation/print version info" description="verbose operation/print version info"
        flag "-x" summary="exclude the following names" description="exclude the following names"
        flag "-y" summary="store symbolic links as the link instead of the referenced file" description="store symbolic links as the link instead of the referenced file"
        flag "-z" summary="add zipfile comment" description="add zipfile comment"
        argument "archive" summary="ZIP archive" description="Archive file to create or update." required=#true action="files"
        argument "files" summary="Files to archive" description="Files or directories to add to the archive." repeatable=#true action="files"
    }
}

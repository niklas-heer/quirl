catalog "sqlite3" {
    provenance author="Carapace contributors; curated by Quirl contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "sqlite3" summary="Query and manage SQLite databases" description="Opens a SQLite database for interactive use or executes SQL and dot commands non-interactively." {
        intent "open a sqlite database"
        intent "query a sqlite database"
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "--append" summary="Append the database to the end of the file" description="Append the database to the end of the file"
        flag "--ascii" summary="Set output mode to 'ascii'" description="Set output mode to 'ascii'"
        flag "--bail" summary="Stop after hitting an error" description="Stop after hitting an error"
        flag "--batch" summary="Force batch I/O" description="Force batch I/O"
        flag "--box" summary="Set output mode to 'box'" description="Set output mode to 'box'"
        flag "--cmd" summary="run \"COMMAND\" before reading stdin" description="run \"COMMAND\" before reading stdin" value="value"
        flag "--column" summary="Set output mode to 'column'" description="Set output mode to 'column'"
        flag "--csv" summary="Set output mode to 'csv'" description="Set output mode to 'csv'"
        flag "--deserialize" summary="open the database using sqlite3_deserialize()" description="open the database using sqlite3_deserialize()"
        flag "--echo" summary="print inputs before execution" description="print inputs before execution"
        flag "--header" summary="turn headers on or off" description="turn headers on or off"
        flag "--help" summary="show this message" description="show this message"
        flag "--html" summary="set output mode to HTML" description="set output mode to HTML"
        flag "--init" summary="read/process named file" description="read/process named file" value="value" action="files"
        flag "--interactive" summary="force interactive I/O" description="force interactive I/O"
        flag "--json" summary="set output mode to 'json'" description="set output mode to 'json'"
        flag "--line" summary="set output mode to 'line'" description="set output mode to 'line'"
        flag "--list" summary="set output mode to 'list'" description="set output mode to 'list'"
        flag "--lookaside" summary="use N entries of SZ bytes for lookaside memory" description="use N entries of SZ bytes for lookaside memory" value="value"
        flag "--markdown" summary="set output mode to 'markdown'" description="set output mode to 'markdown'"
        flag "--maxsize" summary="maximum size for a --deserialize database" description="maximum size for a --deserialize database" value="value"
        flag "--memtrace" summary="trace all memory allocations and deallocations" description="trace all memory allocations and deallocations"
        flag "--mmap" summary="default mmap size set to N" description="default mmap size set to N" value="value"
        flag "--newline" summary="set output row separator. Default: '\\n'" description="set output row separator. Default: '\\n'" value="value"
        flag "--no-rowid-in-view" summary="Disable rowid-in-view using sqlite3_config()" description="Disable rowid-in-view using sqlite3_config()"
        flag "--nofollow" summary="refuse to open symbolic links to database files" description="refuse to open symbolic links to database files"
        flag "--nonce" summary="set the safe-mode escape nonce" description="set the safe-mode escape nonce" value="value"
        flag "--nullvalue" summary="set text string for NULL values. Default ''" description="set text string for NULL values. Default ''" value="value"
        flag "--pagecache" summary="use N slots of SZ bytes each for page cache memory" description="use N slots of SZ bytes each for page cache memory" value="value"
        flag "--pcachetrace" summary="trace all page cache operations" description="trace all page cache operations"
        flag "--quote" summary="set output mode to 'quote'" description="set output mode to 'quote'"
        flag "--readonly" summary="open the database read-only" description="open the database read-only"
        flag "--safe" summary="enable safe-mode" description="enable safe-mode"
        flag "--separator" summary="set output column separator. Default: '|" description="set output column separator. Default: '|" value="value"
        flag "--stats" summary="print memory stats before each finalize" description="print memory stats before each finalize"
        flag "--table" summary="set output mode to 'table'" description="set output mode to 'table'"
        flag "--tabs" summary="set output mode to 'tabs'" description="set output mode to 'tabs'"
        flag "--unsafe-testing" summary="allow unsafe commands and modes for testing" description="allow unsafe commands and modes for testing"
        flag "--version" summary="show SQLite version" description="show SQLite version"
        flag "--vfs" summary="use NAME as the default VFS" description="use NAME as the default VFS" value="value"
        flag "--vfstrace" summary="enable tracing of all VFS calls" description="enable tracing of all VFS calls"
        flag "--zip" summary="open the file as a ZIP Archive" description="open the file as a ZIP Archive"
        flag "-A" summary="run \".archive ARGS\" and exit" description="run \".archive ARGS\" and exit" value="value"
        argument "database" summary="Database file" description="SQLite database to open; omit it for a transient in-memory database." action="files"
        argument "commands" summary="SQL or dot commands" description="Commands to execute before exiting instead of starting the interactive shell." repeatable=#true
    }
}

catalog "code" {
    provenance author="Carapace contributors; curated by Quirl contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "code" summary="Open Visual Studio Code" description="Opens files, folders, workspaces, or editor-management operations in Visual Studio Code." {
        intent "open a file in visual studio code"
        intent "open a project in visual studio code"
        platform "linux"
        platform "macos"
        platform "windows"
        platform "freebsd"
        flag "--add" summary="Add folder(s) to the last active window." description="Add folder(s) to the last active window." short="-a" value="value" action="directories"
        flag "--category" summary="Filters installed extensions by provided category, when using --list-extensions." description="Filters installed extensions by provided category, when using --list-extensions." value="value"
        flag "--diff" summary="Compare two files with each other." description="Compare two files with each other."
        flag "--disable-extension" summary="Disable an extension." description="Disable an extension." value="value"
        flag "--disable-extensions" summary="Disable all installed extensions." description="Disable all installed extensions."
        flag "--disable-gpu" summary="Disable GPU hardware acceleration." description="Disable GPU hardware acceleration."
        flag "--enable-proposed-api" summary="Enables proposed API features for extensions." description="Enables proposed API features for extensions." value="value"
        flag "--extensions-dir" summary="Set the root path for extensions." description="Set the root path for extensions." value="value" action="directories"
        flag "--goto" summary="Open a file at the path on the specified line and character position." description="Open a file at the path on the specified line and character position." short="-g" value="value"
        flag "--help" summary="Print usage." description="Print usage." short="-h"
        flag "--inspect-brk-extensions" summary="Allow debugging and profiling of extensions with the extension host being paused after start." description="Allow debugging and profiling of extensions with the extension host being paused after start." value="value"
        flag "--inspect-extensions" summary="Allow debugging and profiling of extensions." description="Allow debugging and profiling of extensions." value="value"
        flag "--install-extension" summary="Installs or updates the extension." description="Installs or updates the extension." value="value"
        flag "--list-extensions" summary="List the installed extensions." description="List the installed extensions."
        flag "--locale" summary="The locale to use (e.g. en-US or zh-TW)." description="The locale to use (e.g. en-US or zh-TW)." value="value"
        flag "--log" summary="Log level to use." description="Log level to use." value="value"
        flag "--max-memory" summary="Max memory size for a window (in Mbytes)." description="Max memory size for a window (in Mbytes)." value="value"
        flag "--new-window" summary="Force to open a new window." description="Force to open a new window." short="-n"
        flag "--prof-startup" summary="Run CPU profiler during startup." description="Run CPU profiler during startup."
        flag "--reuse-window" summary="Force to open a file or folder in an already opened window." description="Force to open a file or folder in an already opened window." short="-r"
        flag "--show-versions" summary="Show versions of installed extensions, when using --list-extensions." description="Show versions of installed extensions, when using --list-extensions."
        flag "--status" summary="Print process usage and diagnostics information." description="Print process usage and diagnostics information." short="-s"
        flag "--sync" summary="Turn sync on or off." description="Turn sync on or off." value="value"
        flag "--telemetry" summary="Shows all telemetry events which VS code collects." description="Shows all telemetry events which VS code collects."
        flag "--uninstall-extension" summary="Uninstalls an extension." description="Uninstalls an extension." value="value"
        flag "--user-data-dir" summary="Specifies the directory that user data is kept in." description="Specifies the directory that user data is kept in." value="value" action="directories"
        flag "--verbose" summary="Print verbose output (implies --wait)." description="Print verbose output (implies --wait)."
        flag "--version" summary="Print version." description="Print version." short="-v"
        flag "--wait" summary="Wait for the files to be closed before returning." description="Wait for the files to be closed before returning." short="-w"
        argument "paths" summary="Files or folders to open" description="Filesystem paths to open in the editor." repeatable=#true action="files"
    }
}

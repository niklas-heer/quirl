catalog "cp" {
    provenance author="Carapace contributors; curated by Quirl contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "cp" summary="Copy files and directories" description="Copies one or more source paths to a destination file or directory." {
        intent "copy a directory"
        intent "copy a file"
        platform "linux"
        platform "freebsd"
        flag "--archive" summary="same as -dR --preserve=all" description="same as -dR --preserve=all" short="-a"
        flag "--attributes-only" summary="don't copy the file data, just the attributes" description="don't copy the file data, just the attributes"
        flag "--backup" summary="make a backup of each existing destination file" description="make a backup of each existing destination file" value="value"
        flag "--context" summary="like -Z, or if CTX is specified then set the SELinux or SMACK security context to CTX" description="like -Z, or if CTX is specified then set the SELinux or SMACK security context to CTX" value="value"
        flag "--copy-contents" summary="copy contents of special files when recursive" description="copy contents of special files when recursive"
        flag "--debug" summary="explain how a file is copied" description="explain how a file is copied"
        flag "--dereference" summary="always follow symbolic links in SOURCE" description="always follow symbolic links in SOURCE" short="-L"
        flag "--force" summary="if an existing destination file cannot be opened, remove it and try again (this option is ignored when the -n option is also used)" description="if an existing destination file cannot be opened, remove it and try again (this option is ignored when the -n option is also used)" short="-f"
        flag "--help" summary="display this help and exit" description="display this help and exit"
        flag "--interactive" summary="prompt before overwrite (overrides a previous -n option)" description="prompt before overwrite (overrides a previous -n option)" short="-i"
        flag "--keep-directory-symlink" summary="follow existing symlinks to directories" description="follow existing symlinks to directories"
        flag "--link" summary="hard link files instead of copying" description="hard link files instead of copying" short="-l"
        flag "--no-clobber" summary="(deprecated) silently skip existing files" description="(deprecated) silently skip existing files" short="-n"
        flag "--no-dereference" summary="never follow symbolic links in SOURCE" description="never follow symbolic links in SOURCE" short="-P"
        flag "--no-preserve" summary="don't preserve the specified attributes" description="don't preserve the specified attributes" value="value" repeatable=#true
        flag "--no-target-directory" summary="treat DEST as a normal file" description="treat DEST as a normal file" short="-T"
        flag "--one-file-system" summary="stay on this file system" description="stay on this file system" short="-x"
        flag "--parents" summary="use full source file name under DIRECTORY" description="use full source file name under DIRECTORY"
        flag "--preserve" summary="preserve the specified attributes" description="preserve the specified attributes" value="value" repeatable=#true
        flag "--recursive" summary="copy directories recursively" description="copy directories recursively" short="-r"
        flag "--reflink" summary="control clone/CoW copies" description="control clone/CoW copies" value="value"
        flag "--remove-destination" summary="remove each existing destination file before attempting to open it (contrast with --force)" description="remove each existing destination file before attempting to open it (contrast with --force)"
        flag "--sparse" summary="control creation of sparse files." description="control creation of sparse files." value="value"
        flag "--strip-trailing-slashes" summary="remove any trailing slashes from each SOURCE argument" description="remove any trailing slashes from each SOURCE argument"
        flag "--suffix" summary="override the usual backup suffix" description="override the usual backup suffix" short="-S" value="value"
        flag "--symbolic-link" summary="make symbolic links instead of copying" description="make symbolic links instead of copying" short="-s"
        flag "--target-directory" summary="copy all SOURCE arguments into DIRECTORY" description="copy all SOURCE arguments into DIRECTORY" short="-t" value="value" action="directories"
        flag "--update" summary="control which existing files are updated" description="control which existing files are updated" value="value"
        flag "--verbose" summary="explain what is being done" description="explain what is being done" short="-v"
        flag "--version" summary="output version information and exit" description="output version information and exit"
        flag "-b" summary="Back up overwritten destinations" description="Like --backup, but without accepting a backup-control value."
        flag "-d" summary="Preserve symbolic links" description="Equivalent to --no-dereference --preserve=links."
        flag "-p" summary="Preserve core file attributes" description="Equivalent to --preserve=mode,ownership,timestamps."
        flag "-u" summary="Copy only newer or missing files" description="Equivalent to --update=older."
        argument "paths" summary="Sources and destination" description="Source paths followed by the destination path; the final path is the destination." required=#true repeatable=#true action="files"
    }
}

catalog "cd" {
    provenance author="Carapace contributors; curated by Quirl contributors" license="MIT" revision="ebfb9beda84fdf057dc9a89b59527158d23d323c" source="https://github.com/carapace-sh/carapace-bin"
    command "cd" summary="Change the working directory" description="Changes the shell's current working directory, using the home directory when no directory is supplied." {
        intent "change directory"
        intent "go to a folder"
        platform "linux"
        platform "macos"
        platform "freebsd"
        flag "-L" summary="Follow symbolic links logically" description="Resolve parent components after following symbolic links; this is the default."
        flag "-P" summary="Use the physical directory structure" description="Resolve symbolic links while changing directory."
        flag "-e" summary="Fail when the physical directory cannot be determined" description="With -P, return a nonzero status when the current working directory cannot be determined."
        argument "directory" summary="Destination directory" description="Directory to make current; omit it to select the shell's home directory." action="directories"
    }
}

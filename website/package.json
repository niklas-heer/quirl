{
  "name": "quirl-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run sync:docs && next build",
    "dev": "npm run sync:docs && next dev",
    "sync:docs": "node scripts/sync-docs.mjs",
    "sync:docs:check": "node scripts/sync-docs.mjs --check",
    "sync:reference": "node scripts/sync-generated-reference.mjs",
    "sync:reference:check": "node scripts/sync-generated-reference.mjs --check",
    "check:generated": "npm run sync:docs:check && npm run sync:reference:check",
    "check": "npm run check:generated && npm run lint && npm run types:check && next build",
    "start": "next start",
    "types:check": "next typegen && tsc --noEmit",
    "lint": "eslint"
  },
  "dependencies": {
    "cnfast": "^0.1.0",
    "fumadocs-core": "16.14.4",
    "fumadocs-mdx": "15.2.3",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.14.4",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.0"
  }
}
